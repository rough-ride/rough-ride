new file mode 100644
index 0000000..f35e5fb
--- /dev/null
+++ b/backend/routers/waterings.py
@@ -0,0 +1,75 @@
+"""Bed watering log."""
+
+import sqlite3
+from datetime import datetime, timezone
+
+from fastapi import APIRouter, Depends, Query, Response, status
+
+from db import get_db
+from routers.common import ensure_bed_exists, not_found
+from schemas import WateringIn, WateringOut
+from security import require_user
+
+router = APIRouter(
+    prefix="/api/waterings", tags=["waterings"], dependencies=[Depends(require_user)]
+)
+
+WATERING_SELECT = """
+SELECT w.id, w.bed_id, b.name AS bed_name, w.watered_on, w.watered_at, w.litres
+FROM waterings w
+JOIN beds b ON b.id = w.bed_id
+"""
+
+# Same-day entries recorded with "Water now" carry a time; they sort above
+# past entries for that day, which only have a date.
+WATERING_ORDER = " ORDER BY w.watered_on DESC, w.watered_at IS NULL, w.watered_at DESC, w.id DESC"
+
+
+def _get_watering(conn: sqlite3.Connection, watering_id: int) -> dict:
+    row = conn.execute(WATERING_SELECT + " WHERE w.id = ?", (watering_id,)).fetchone()
+    if row is None:
+        raise not_found("Watering")
+    return dict(row)
+
+
+@router.get("", response_model=list[WateringOut])
+def list_waterings(
+    bed_id: int | None = Query(default=None, gt=0),
+    limit: int | None = Query(default=None, ge=1, le=1000),
+    conn: sqlite3.Connection = Depends(get_db),
+) -> list[dict]:
+    where, params = "", []
+    if bed_id is not None:
+        where, params = " WHERE w.bed_id = ?", [bed_id]
+    sql = WATERING_SELECT + where + WATERING_ORDER
+    if limit is not None:
+        sql += " LIMIT ?"
+        params.append(limit)
+    return [dict(r) for r in conn.execute(sql, params).fetchall()]
+
+
+@router.post("", response_model=WateringOut, status_code=status.HTTP_201_CREATED)
+def create_watering(payload: WateringIn, conn: sqlite3.Connection = Depends(get_db)) -> dict:
+    """Records a watering: without a date it is "now", with the current time."""
+    ensure_bed_exists(conn, payload.bed_id)
+    if payload.watered_on is None:
+        now = datetime.now(timezone.utc).replace(microsecond=0)
+        watered_on = now.astimezone().date().isoformat()
+        watered_at = now.strftime("%Y-%m-%d %H:%M:%S")
+    else:
+        watered_on = payload.watered_on.isoformat()
+        watered_at = None
+    cur = conn.execute(
+        "INSERT INTO waterings (bed_id, watered_on, watered_at, litres) VALUES (?, ?, ?, ?)",
+        (payload.bed_id, watered_on, watered_at, payload.litres),
+    )
+    conn.commit()
+    return _get_watering(conn, cur.lastrowid)
+
+
+@router.delete("/{watering_id}", status_code=status.HTTP_204_NO_CONTENT)
+def delete_watering(watering_id: int, conn: sqlite3.Connection = Depends(get_db)) -> Response:
+    _get_watering(conn, watering_id)
+    conn.execute("DELETE FROM waterings WHERE id = ?", (watering_id,))
+    conn.commit()
+    return Response(status_code=status.HTTP_204_NO_CONTENT)
