+<script setup lang="ts">
+import type { Bed, Watering } from '~/types/api'
+
+useHead({ title: 'Waterings' })
+
+const route = useRoute()
+const router = useRouter()
+const api = useApiClient()
+
+const bedFilter = ref(typeof route.query.bed === 'string' ? route.query.bed : '')
+
+const query = computed(() => {
+  const params: Record<string, string> = {}
+  if (bedFilter.value) params.bed_id = bedFilter.value
+  return params
+})
+
+const [wateringsResult, bedsResult] = await Promise.all([
+  useApiFetch<Watering[]>('/waterings', { query }),
+  useApiFetch<Bed[]>('/beds'),
+])
+
+const { data: waterings, error: wateringsError, status, refresh } = wateringsResult
+const { data: beds } = bedsResult
+
+watch(bedFilter, (bed) => {
+  router.replace({ query: bed ? { bed } : {} })
+})
+
+const removingId = ref<number | null>(null)
+const listError = ref<string | null>(null)
+
+const filtering = computed(() => Boolean(bedFilter.value))
+const totalLitres = computed(() => waterings.value?.reduce((sum, w) => sum + (w.litres ?? 0), 0) ?? 0)
+const resultText = computed(() => {
+  const count = waterings.value?.length ?? 0
+  const amount = totalLitres.value > 0 ? `, ${formatLitres(totalLitres.value)} in total` : ''
+  return `${plural(count, 'watering')}${amount}`
+})
+
+function clearFilter(): void {
+  bedFilter.value = ''
+}
+
+async function removeWatering(watering: Watering): Promise<void> {
+  const when = formatWatered(watering.watered_on, watering.watered_at)
+  if (!window.confirm(`Delete the watering of ${watering.bed_name} on ${when}?`)) return
+  removingId.value = watering.id
+  listError.value = null
+  try {
+    await api(`/waterings/${watering.id}`, { method: 'DELETE' })
+    await refresh()
+  } catch (err) {
+    listError.value = apiErrorMessage(err, 'Could not delete the watering.')
+  } finally {
+    removingId.value = null
+  }
+}
+</script>
+
+<template>
+  <div>
+    <PageHeader title="Waterings" subtitle="Every time a bed was watered.">
+      <template #actions>
+        <NuxtLink to="/beds" class="btn btn--primary">Water a bed</NuxtLink>
+      </template>
+    </PageHeader>
+
+    <form class="filters filters--compact card" role="search" @submit.prevent>
+      <div class="field">
+        <label for="watering-bed">Bed</label>
+        <select id="watering-bed" v-model="bedFilter" name="bed">
+          <option value="">All beds</option>
+          <option v-for="bed in beds ?? []" :key="bed.id" :value="String(bed.id)">
+            {{ bed.name }}
+          </option>
+        </select>
+      </div>
+      <div class="filters__end">
+        <button v-if="filtering" type="button" class="btn btn--ghost" @click="clearFilter">
+          Clear filter
+        </button>
+      </div>
+    </form>
+
+    <p class="results-count" aria-live="polite">
+      <span v-if="status === 'pending'">Loading waterings…</span>
+      <span v-else-if="waterings">{{ resultText }}</span>
+    </p>
+
+    <AlertMessage v-if="wateringsError">
+      {{ apiErrorMessage(wateringsError, 'Could not load waterings.') }}
+    </AlertMessage>
+    <AlertMessage v-if="listError">{{ listError }}</AlertMessage>
+
+    <section v-if="waterings && waterings.length" class="card" aria-labelledby="watering-list-heading">
+      <h2 id="watering-list-heading" class="visually-hidden">Watering log</h2>
+      <table class="table">
+        <caption class="visually-hidden">Waterings, most recent first</caption>
+        <thead>
+          <tr>
+            <th scope="col">When</th>
+            <th scope="col">Bed</th>
+            <th scope="col" class="num">Amount</th>
+            <th scope="col"><span class="visually-hidden">Actions</span></th>
+          </tr>
+        </thead>
+        <tbody>
+          <tr v-for="watering in waterings" :key="watering.id">
+            <td>
+              <time :datetime="watering.watered_at ?? watering.watered_on">
+                {{ formatWatered(watering.watered_on, watering.watered_at) }}
+              </time>
+            </td>
+            <td>{{ watering.bed_name }}</td>
