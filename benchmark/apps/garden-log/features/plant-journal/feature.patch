index 0000000..b63d528
--- /dev/null
+++ b/frontend/app/components/JournalEntryItem.vue
@@ -0,0 +1,88 @@
+<script setup lang="ts">
+import type { JournalEntry, JournalEntryInput } from '~/types/api'
+
+const props = defineProps<{
+  entry: JournalEntry
+  busy?: boolean
+}>()
+
+const emit = defineEmits<{
+  saved: [entry: JournalEntry]
+  remove: [entry: JournalEntry]
+}>()
+
+const api = useApiClient()
+const editing = ref(false)
+const saving = ref(false)
+const saveError = ref<string | null>(null)
+const editButton = ref<HTMLButtonElement | null>(null)
+
+const edited = computed(() => props.entry.updated_at !== props.entry.created_at)
+
+function startEditing(): void {
+  saveError.value = null
+  editing.value = true
+}
+
+async function stopEditing(): Promise<void> {
+  editing.value = false
+  saveError.value = null
+  await nextTick()
+  editButton.value?.focus()
+}
+
+async function save(value: JournalEntryInput): Promise<void> {
+  saving.value = true
+  saveError.value = null
+  try {
+    const updated = await api<JournalEntry>(`/journal/${props.entry.id}`, { method: 'PUT', body: value })
+    emit('saved', updated)
+    await stopEditing()
+  } catch (err) {
+    saveError.value = apiErrorMessage(err, 'Could not save the entry.')
+  } finally {
+    saving.value = false
+  }
+}
+</script>
+
+<template>
+  <li class="journal-entry" :class="{ 'journal-entry--editing': editing }">
+    <JournalEntryForm
+      v-if="editing"
+      :initial="{ entry_on: entry.entry_on, body: entry.body }"
+      submit-label="Save entry"
+      :pending="saving"
+      :error="saveError"
+      cancellable
+      @submit="save"
+      @cancel="stopEditing"
+    />
+    <template v-else>
+      <div class="journal-entry__head">
+        <time class="journal-entry__date" :datetime="entry.entry_on">{{ formatDate(entry.entry_on) }}</time>
+        <span v-if="edited" class="journal-entry__edited">edited</span>
+      </div>
+      <p class="journal-entry__body prewrap">{{ entry.body }}</p>
+      <div class="journal-entry__actions">
+        <button
+          ref="editButton"
+          type="button"
+          class="btn btn--ghost btn--small"
+          :disabled="busy"
+          @click="startEditing"
+        >
+          Edit<span class="visually-hidden"> entry from {{ formatDate(entry.entry_on) }}</span>
+        </button>
+        <button
+          type="button"
+          class="btn btn--ghost btn--small"
+          :disabled="busy"
+          @click="emit('remove', entry)"
+        >
+          Delete<span class="visually-hidden"> entry from {{ formatDate(entry.entry_on) }}</span>
+        </button>
+      </div>
+    </template>
+  </li>
+</template>
