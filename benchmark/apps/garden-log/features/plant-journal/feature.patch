diff --git a/frontend/app/pages/journal.vue b/frontend/app/pages/journal.vue
new file mode 100644
index 0000000..66243a6
--- /dev/null
+++ b/frontend/app/pages/journal.vue
@@ -0,0 +1,99 @@
+<script setup lang="ts">
+import type { JournalEntry } from '~/types/api'
+
+useHead({ title: 'Journal' })
+
+const LATEST_LIMIT = 50
+
+const route = useRoute()
+const router = useRouter()
+
+const search = ref(typeof route.query.q === 'string' ? route.query.q : '')
+
+const query = computed(() => {
+  const params: Record<string, string | number> = { limit: LATEST_LIMIT }
+  if (search.value.trim()) params.q = search.value.trim()
+  return params
+})
+
+const { data: entries, error: loadError, status } = await useApiFetch<JournalEntry[]>('/journal', { query })
+
+watch(search, (q) => {
+  router.replace({ query: q.trim() ? { q: q.trim() } : {} })
+})
+
+const searching = computed(() => Boolean(search.value.trim()))
+const resultText = computed(() => {
+  const count = entries.value?.length ?? 0
+  if (searching.value) return `${plural(count, 'entry', 'entries')} match`
+  return count >= LATEST_LIMIT ? `Latest ${LATEST_LIMIT} entries` : plural(count, 'entry', 'entries')
+})
+
+function clearSearch(): void {
+  search.value = ''
+}
+</script>
+
+<template>
+  <div>
+    <PageHeader title="Journal" subtitle="The latest notes from across the garden, newest first.">
+      <template #actions>
+        <NuxtLink to="/plants" class="btn btn--ghost">Write in a plant's journal</NuxtLink>
+      </template>
+    </PageHeader>
+
+    <form class="filters filters--single card" role="search" @submit.prevent>
+      <div class="field">
+        <label for="journal-search">Search</label>
+        <input
+          id="journal-search"
+          v-model="search"
+          type="search"
+          name="q"
+          placeholder="Search entries or plant names"
+          autocomplete="off"
+        >
+      </div>
+      <div class="filters__end">
+        <button v-if="searching" type="button" class="btn btn--ghost" @click="clearSearch">
+          Clear search
+        </button>
+      </div>
+    </form>
+
+    <p class="results-count" aria-live="polite">
+      <span v-if="status === 'pending'">Loading entries…</span>
+      <span v-else-if="entries">{{ resultText }}</span>
+    </p>
+
+    <AlertMessage v-if="loadError">
+      {{ apiErrorMessage(loadError, 'Could not load the journal.') }}
+    </AlertMessage>
+
+    <ol v-else-if="entries && entries.length" class="journal-feed">
+      <li v-for="entry in entries" :key="entry.id" class="journal-feed__item card">
+        <div class="journal-entry__head">
+          <NuxtLink :to="`/plants/${entry.plant_id}`" class="journal-feed__plant">{{ entry.plant_name }}</NuxtLink>
+          <time class="journal-entry__date" :datetime="entry.entry_on">{{ formatDate(entry.entry_on) }}</time>
+        </div>
+        <p class="journal-entry__body prewrap">{{ entry.body }}</p>
+      </li>
+    </ol>
+
+    <EmptyState
+      v-else-if="entries && searching"
+      title="No entries match"
+      message="Try a different word or plant name."
+    >
+      <button type="button" class="btn btn--ghost" @click="clearSearch">Clear search</button>
+    </EmptyState>
+
+    <EmptyState
+      v-else-if="entries"
+      title="No journal entries yet"
+      message="Open a plant and write the first entry in its journal."
+    >
+      <NuxtLink to="/plants" class="btn btn--primary">Go to plants</NuxtLink>
+    </EmptyState>
+  </div>
+</template>
