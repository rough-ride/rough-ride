diff --git a/frontend/app/components/JournalEntryForm.vue b/frontend/app/components/JournalEntryForm.vue
new file mode 100644
index 0000000..1726f01
--- /dev/null
+++ b/frontend/app/components/JournalEntryForm.vue
@@ -0,0 +1,101 @@
+<script setup lang="ts">
+import type { JournalEntryInput } from '~/types/api'
+
+const BODY_LIMIT = 500
+
+const props = withDefaults(defineProps<{
+  initial?: Partial<JournalEntryInput>
+  submitLabel: string
+  pending?: boolean
+  error?: string | null
+  cancellable?: boolean
+}>(), {
+  initial: () => ({}),
+  pending: false,
+  error: null,
+  cancellable: false,
+})
+
+const emit = defineEmits<{
+  submit: [value: JournalEntryInput]
+  cancel: []
+}>()
+
+const ids = {
+  date: useId(),
+  body: useId(),
+  count: useId(),
+}
+
+const today = todayIso()
+const form = reactive({
+  entryOn: props.initial.entry_on ?? today,
+  body: props.initial.body ?? '',
+})
+
+const localError = ref<string | null>(null)
+const shownError = computed(() => localError.value ?? props.error)
+const remaining = computed(() => BODY_LIMIT - form.body.length)
+const bodyInput = ref<HTMLTextAreaElement | null>(null)
+
+function validate(): string | null {
+  if (!form.entryOn) return 'Choose a date.'
+  if (form.entryOn > today) return 'Journal date cannot be in the future.'
+  if (!form.body.trim()) return 'Write something for the entry.'
+  if (form.body.trim().length > BODY_LIMIT) return `Keep the entry to ${BODY_LIMIT} characters.`
+  return null
+}
+
+function handleSubmit(): void {
+  localError.value = validate()
+  if (localError.value) return
+  emit('submit', { entry_on: form.entryOn, body: form.body.trim() })
+}
+
+/** Clears the text after a successful save; keeps the date for the next entry. */
+function reset(): void {
+  form.body = ''
+  localError.value = null
+}
+
+function focus(): void {
+  bodyInput.value?.focus()
+}
+
+defineExpose({ reset, focus })
+</script>
+
+<template>
+  <form class="form journal-form" novalidate @submit.prevent="handleSubmit">
+    <AlertMessage v-if="shownError">{{ shownError }}</AlertMessage>
+    <div class="field journal-form__date">
+      <label :for="ids.date">Date</label>
+      <input :id="ids.date" v-model="form.entryOn" type="date" name="entry_on" :max="today" required>
+    </div>
+    <div class="field">
+      <label :for="ids.body">Entry</label>
+      <textarea
+        :id="ids.body"
+        ref="bodyInput"
+        v-model="form.body"
+        name="body"
+        rows="3"
+        :maxlength="BODY_LIMIT"
+        :aria-describedby="ids.count"
+        placeholder="First flowers opened; watered deeply."
+        required
+      />
+      <p :id="ids.count" class="field__hint" :class="{ 'journal-form__count--low': remaining < 50 }">
+        {{ plural(remaining, 'character') }} left
+      </p>
+    </div>
+    <div class="form__actions">
+      <button type="submit" class="btn btn--primary" :disabled="pending">
+        {{ pending ? 'Saving…' : submitLabel }}
+      </button>
+      <button v-if="cancellable" type="button" class="btn btn--ghost" :disabled="pending" @click="emit('cancel')">
+        Cancel
+      </button>
+    </div>
+  </form>
+</template>
diff --git a/frontend/app/components/JournalEntryItem.vue b/frontend/app/components/JournalEntryItem.vue
