diff --git a/backend/routers/journal.py b/backend/routers/journal.py
new file mode 100644
index 0000000..d3ba965
--- /dev/null
+++ b/backend/routers/journal.py
@@ -0,0 +1,90 @@
+"""Dated journal entries written about a plant."""
+
+import sqlite3
+
+from fastapi import APIRouter, Depends, Query, Response, status
+
+from db import get_db
+from routers.common import ensure_plant_exists, escape_like, not_found
+from schemas import JournalEntryCreate, JournalEntryIn, JournalEntryOut
+from security import require_user
+
+router = APIRouter(
+    prefix="/api/journal", tags=["journal"], dependencies=[Depends(require_user)]
+)
+
+JOURNAL_SELECT = """
+SELECT j.id, j.plant_id, p.name AS plant_name, j.entry_on, j.body,
+       j.created_at, j.updated_at
+FROM journal_entries j
+JOIN plants p ON p.id = j.plant_id
+"""
+
+NEWEST_FIRST = " ORDER BY j.entry_on DESC, j.id DESC"
+
+
+def _get_entry(conn: sqlite3.Connection, entry_id: int) -> dict:
+    row = conn.execute(JOURNAL_SELECT + " WHERE j.id = ?", (entry_id,)).fetchone()
+    if row is None:
+        raise not_found("Journal entry")
+    return dict(row)
+
+
+@router.get("", response_model=list[JournalEntryOut])
+def list_entries(
+    q: str = Query(default="", max_length=80),
+    plant_id: int | None = Query(default=None, gt=0),
+    limit: int = Query(default=50, ge=1, le=500),
+    conn: sqlite3.Connection = Depends(get_db),
+) -> list[dict]:
+    clauses: list[str] = []
+    params: list[object] = []
+    term = q.strip()
+    if term:
+        pattern = f"%{escape_like(term)}%"
+        clauses.append("(j.body LIKE ? ESCAPE '\\' OR p.name LIKE ? ESCAPE '\\')")
+        params.extend([pattern, pattern])
+    if plant_id is not None:
+        clauses.append("j.plant_id = ?")
+        params.append(plant_id)
+    where = f" WHERE {' AND '.join(clauses)}" if clauses else ""
+    rows = conn.execute(
+        JOURNAL_SELECT + where + NEWEST_FIRST + " LIMIT ?", [*params, limit]
+    ).fetchall()
+    return [dict(r) for r in rows]
+
+
+@router.post("", response_model=JournalEntryOut, status_code=status.HTTP_201_CREATED)
+def create_entry(payload: JournalEntryCreate, conn: sqlite3.Connection = Depends(get_db)) -> dict:
+    ensure_plant_exists(conn, payload.plant_id)
+    cur = conn.execute(
+        "INSERT INTO journal_entries (plant_id, entry_on, body) VALUES (?, ?, ?)",
+        (payload.plant_id, payload.entry_on.isoformat(), payload.body),
+    )
+    conn.commit()
+    return _get_entry(conn, cur.lastrowid)
+
+
+@router.put("/{entry_id}", response_model=JournalEntryOut)
+def update_entry(
+    entry_id: int, payload: JournalEntryIn, conn: sqlite3.Connection = Depends(get_db)
+) -> dict:
+    _get_entry(conn, entry_id)
+    conn.execute(
+        """
+        UPDATE journal_entries
+        SET entry_on = ?, body = ?, updated_at = datetime('now')
+        WHERE id = ?
+        """,
+        (payload.entry_on.isoformat(), payload.body, entry_id),
+    )
+    conn.commit()
+    return _get_entry(conn, entry_id)
+
+
+@router.delete("/{entry_id}", status_code=status.HTTP_204_NO_CONTENT)
+def delete_entry(entry_id: int, conn: sqlite3.Connection = Depends(get_db)) -> Response:
+    _get_entry(conn, entry_id)
+    conn.execute("DELETE FROM journal_entries WHERE id = ?", (entry_id,))
+    conn.commit()
+    return Response(status_code=status.HTTP_204_NO_CONTENT)
