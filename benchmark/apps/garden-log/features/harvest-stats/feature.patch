diff --git a/frontend/app/pages/stats.vue b/frontend/app/pages/stats.vue
new file mode 100644
index 0000000..c817eb5
--- /dev/null
+++ b/frontend/app/pages/stats.vue
@@ -0,0 +1,153 @@
+<script setup lang="ts">
+import type { HarvestStats } from '~/types/api'
+
+useHead({ title: 'Stats' })
+
+const route = useRoute()
+const router = useRouter()
+
+const year = todayIso().slice(0, 4)
+const defaultFrom = `${year}-01-01`
+const defaultTo = `${year}-12-31`
+
+function queryDate(value: unknown, fallback: string): string {
+  return typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value) ? value : fallback
+}
+
+const dateFrom = ref(queryDate(route.query.from, defaultFrom))
+const dateTo = ref(queryDate(route.query.to, defaultTo))
+
+const query = computed(() => {
+  const params: Record<string, string> = {}
+  if (dateFrom.value) params.from = dateFrom.value
+  if (dateTo.value) params.to = dateTo.value
+  return params
+})
+
+const { data: stats, error: statsError, status } = await useApiFetch<HarvestStats>('/stats/harvests', { query })
+
+watch([dateFrom, dateTo], ([from, to]) => {
+  const next: Record<string, string> = {}
+  if (from && from !== defaultFrom) next.from = from
+  if (to && to !== defaultTo) next.to = to
+  router.replace({ query: next })
+})
+
+const isDefaultRange = computed(() => dateFrom.value === defaultFrom && dateTo.value === defaultTo)
+
+const rangeText = computed(() => {
+  if (!stats.value) return ''
+  const { date_from: from, date_to: to, harvest_count: count } = stats.value
+  return `${plural(count, 'harvest')} from ${formatDate(from)} to ${formatDate(to)}`
+})
+
+function resetRange(): void {
+  dateFrom.value = defaultFrom
+  dateTo.value = defaultTo
+}
+</script>
+
+<template>
+  <div>
+    <PageHeader title="Stats" subtitle="Harvest weight per plant and month.">
+      <template #actions>
+        <NuxtLink to="/harvests/new" class="btn btn--primary">Log harvest</NuxtLink>
+      </template>
+    </PageHeader>
+
+    <form class="filters filters--range card" aria-label="Date range" @submit.prevent>
+      <div class="field">
+        <label for="stats-from">From</label>
+        <input id="stats-from" v-model="dateFrom" type="date" name="from" :max="dateTo || undefined">
+      </div>
+      <div class="field">
+        <label for="stats-to">To</label>
+        <input id="stats-to" v-model="dateTo" type="date" name="to" :min="dateFrom || undefined">
+      </div>
+      <div class="filters__end">
+        <button v-if="!isDefaultRange" type="button" class="btn btn--ghost" @click="resetRange">
+          This year
+        </button>
+      </div>
+    </form>
+
+    <p class="results-count" aria-live="polite">
+      <span v-if="status === 'pending'">Loading stats…</span>
+      <span v-else-if="stats">{{ rangeText }}</span>
+    </p>
+
+    <AlertMessage v-if="statsError">
+      {{ apiErrorMessage(statsError, 'Could not load harvest stats.') }}
+    </AlertMessage>
+
+    <template v-else-if="stats && stats.plants.length">
+      <section aria-labelledby="top-heading" class="section">
+        <h2 id="top-heading">Best plants</h2>
+        <ol class="stats">
+          <li v-for="(plant, index) in stats.top_plants" :key="plant.plant_id" class="stat">
+            <p class="stat__label">No. {{ index + 1 }}</p>
+            <p class="stat__value">{{ plant.plant_name }}</p>
+            <p class="stat__hint">
+              {{ formatWeight(plant.total_grams) }}<template v-if="plant.variety"> · {{ plant.variety }}</template>
+            </p>
+            <NuxtLink :to="`/plants/${plant.plant_id}`" class="stat__link">
+              View<span class="visually-hidden"> {{ plant.plant_name }}</span>
+            </NuxtLink>
+          </li>
+        </ol>
+      </section>
+
+      <section aria-labelledby="table-heading" class="section card">
+        <div class="section__head">
+          <h2 id="table-heading">Weight by plant and month</h2>
+          <span class="badge">{{ formatWeight(stats.total_grams) }} total</span>
+        </div>
+        <div class="table-scroll">
+          <table class="table stats-table">
+            <caption class="visually-hidden">
+              Harvest weight per plant and month, {{ formatDate(stats.date_from) }} to {{ formatDate(stats.date_to) }}
+            </caption>
+            <thead>
+              <tr>
+                <th scope="col">Plant</th>
+                <th v-for="month in stats.months" :key="month.month" scope="col" class="num">
+                  {{ formatMonth(month.month) }}
+                </th>
+                <th scope="col" class="num">Total</th>
+              </tr>
+            </thead>
+            <tbody>
+              <tr v-for="plant in stats.plants" :key="plant.plant_id">
+                <th scope="row">
+                  <NuxtLink :to="`/plants/${plant.plant_id}`" class="link">{{ plant.plant_name }}</NuxtLink>
+                  <span v-if="plant.variety" class="muted"> · {{ plant.variety }}</span>
+                </th>
+                <td v-for="(grams, index) in plant.monthly_grams" :key="stats.months[index]?.month" class="num">
+                  {{ grams ? formatWeight(grams) : '–' }}
+                </td>
+                <td class="num">{{ formatWeight(plant.total_grams) }}</td>
+              </tr>
+            </tbody>
+            <tfoot>
+              <tr>
+                <th scope="row">Total</th>
+                <td v-for="month in stats.months" :key="month.month" class="num">
+                  {{ formatWeight(month.total_grams) }}
+                </td>
+                <td class="num">{{ formatWeight(stats.total_grams) }}</td>
+              </tr>
+            </tfoot>
+          </table>
+        </div>
+      </section>
+    </template>
+
+    <EmptyState
+      v-else-if="stats"
+      title="No harvests in this range"
+      message="Pick a different date range, or log a harvest to see it here."
+    >
+      <NuxtLink to="/harvests/new" class="btn btn--ghost">Log harvest</NuxtLink>
+    </EmptyState>
+  </div>
+</template>
