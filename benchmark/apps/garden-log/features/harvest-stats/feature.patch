diff --git a/backend/routers/stats.py b/backend/routers/stats.py
new file mode 100644
index 0000000..bd5a25b
--- /dev/null
+++ b/backend/routers/stats.py
@@ -0,0 +1,101 @@
+"""Harvest statistics over a date range."""
+
+import sqlite3
+from datetime import date
+
+from fastapi import APIRouter, Depends, HTTPException, Query, status
+
+from db import get_db
+from schemas import HarvestStatsOut
+from security import require_user
+
+router = APIRouter(prefix="/api/stats", tags=["stats"], dependencies=[Depends(require_user)])
+
+TOP_PLANT_LIMIT = 3
+
+
+def year_bounds(year: int) -> tuple[date, date]:
+    return date(year, 1, 1), date(year, 12, 31)
+
+
+def top_plants(
+    conn: sqlite3.Connection, date_from: date, date_to: date, limit: int = TOP_PLANT_LIMIT
+) -> list[dict]:
+    """Plants with the most harvested weight in the range, heaviest first."""
+    rows = conn.execute(
+        """
+        SELECT p.id AS plant_id, p.name AS plant_name, p.variety,
+               SUM(h.weight_grams) AS total_grams
+        FROM harvests h JOIN plants p ON p.id = h.plant_id
+        WHERE h.harvested_on BETWEEN ? AND ?
+        GROUP BY p.id
+        ORDER BY total_grams DESC, p.name, p.id
+        LIMIT ?
+        """,
+        (date_from.isoformat(), date_to.isoformat(), limit),
+    ).fetchall()
+    return [dict(r) for r in rows]
+
+
+@router.get("/harvests", response_model=HarvestStatsOut)
+def harvest_stats(
+    date_from: date | None = Query(default=None, alias="from"),
+    date_to: date | None = Query(default=None, alias="to"),
+    conn: sqlite3.Connection = Depends(get_db),
+) -> dict:
+    year_start, year_end = year_bounds(date.today().year)
+    date_from = date_from or year_start
+    date_to = date_to or year_end
+    if date_from > date_to:
+        raise HTTPException(
+            status_code=status.HTTP_422_UNPROCESSABLE_CONTENT,
+            detail="The From date must be on or before the To date.",
+        )
+
+    rows = conn.execute(
+        """
+        SELECT p.id AS plant_id, p.name AS plant_name, p.variety,
+               substr(h.harvested_on, 1, 7) AS month,
+               SUM(h.weight_grams) AS grams, COUNT(*) AS harvests
+        FROM harvests h JOIN plants p ON p.id = h.plant_id
+        WHERE h.harvested_on BETWEEN ? AND ?
+        GROUP BY p.id, month
+        ORDER BY p.name, p.id, month
+        """,
+        (date_from.isoformat(), date_to.isoformat()),
+    ).fetchall()
+
+    months = sorted({row["month"] for row in rows})
+    month_index = {month: i for i, month in enumerate(months)}
+    month_totals = [0] * len(months)
+    plants: dict[int, dict] = {}
+    harvest_count = 0
+
+    for row in rows:
+        plant = plants.setdefault(
+            row["plant_id"],
+            {
+                "plant_id": row["plant_id"],
+                "plant_name": row["plant_name"],
+                "variety": row["variety"],
+                "monthly_grams": [0] * len(months),
+                "total_grams": 0,
+            },
+        )
+        i = month_index[row["month"]]
+        plant["monthly_grams"][i] = row["grams"]
+        plant["total_grams"] += row["grams"]
+        month_totals[i] += row["grams"]
+        harvest_count += row["harvests"]
+
+    return {
+        "date_from": date_from,
+        "date_to": date_to,
+        "months": [
+            {"month": month, "total_grams": total} for month, total in zip(months, month_totals)
+        ],
+        "plants": list(plants.values()),
+        "total_grams": sum(month_totals),
+        "harvest_count": harvest_count,
+        "top_plants": top_plants(conn, date_from, date_to),
+    }
