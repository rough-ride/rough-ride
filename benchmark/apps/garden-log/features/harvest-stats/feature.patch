diff --git a/frontend/app/utils/format.ts b/frontend/app/utils/format.ts
index f1a3d3c..be6d0bf 100644
--- a/frontend/app/utils/format.ts
+++ b/frontend/app/utils/format.ts
@@ -14,6 +14,18 @@ export function formatDate(value: string | null | undefined): string {
   return Number.isNaN(date.getTime()) ? value : dateFormatter.format(date)
 }
 
+const monthFormatter = new Intl.DateTimeFormat('en-GB', {
+  month: 'short',
+  year: 'numeric',
+  timeZone: 'UTC',
+})
+
+/** Formats a calendar month (YYYY-MM) as e.g. "Jun 2026". */
+export function formatMonth(value: string): string {
+  const date = new Date(`${value.slice(0, 7)}-01T00:00:00Z`)
+  return Number.isNaN(date.getTime()) ? value : monthFormatter.format(date)
+}
+
 export function formatWeight(grams: number | null | undefined): string {
   if (grams === null || grams === undefined) return '–'
   if (grams >= 1000) {
