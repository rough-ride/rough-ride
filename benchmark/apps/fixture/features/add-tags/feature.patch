@@ -0,0 +1,10 @@
+// Tags for notes: each note keeps a short list of labels.
+export function addTag(note, tag) {
+  const clean = tag.trim().toLowerCase();
+  if (!clean) return note;
+  return { ...note, tags: [...(note.tags ?? []), clean] };
+}
+
+export function tagList(note) {
+  return (note.tags ?? []).join(', ');
+}
