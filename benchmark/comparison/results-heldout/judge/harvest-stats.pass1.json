  "issues": {
    "hx1": "On /stats, when an earlier range's stats response arrives after a later one, the page shows the earlier range's results while the date fields show the newer range; triggered by changing the dates twice quickly with the first request slower.",
    "hx2": "On /stats, plants sharing a name are merged into one row of the weight-by-month table (grouped by name, not id) while Best plants lists them separately; triggered by creating two plants with the same name and logging harvests for both.",
    "stale-summary-on-error": "On /stats, after a successful load, a failed request for a new range leaves the old range's '<n> harvests from ... to ...' summary line visible next to the error; triggered by making the next stats request fail after changing dates.",
    "stats-no-timeout": "On /stats, a stats request that never answers leaves 'Loading stats…' on screen indefinitely (often above the previous range's results) with no timeout or error; triggered by making /api/stats/harvests hang and opening the page or changing a date.",
    "raw-validation-message": "On /stats, an invalid date (e.g. ?from=2026-02-30 or a five-digit year) shows the raw validation text 'Query.from: Input should be a valid date or datetime…' and the date input appears blank; triggered by opening such a URL or typing such a date.",
    "malformed-response-crash": "On /stats, a 200 response with a malformed, non-JSON, empty or null-field body throws an uncaught TypeError, leaving the page stuck on 'Loading stats…' over old data (or not rendering at all on client navigation); triggered by mocking /api/stats/harvests with such a body and changing a date or navigating to Stats.",
    "malformed-response-renders-placeholders": "On /stats, a stats response with null or missing fields renders as 'undefined/null harvests from – to –' with empty sections instead of an error state; triggered by mocking /api/stats/harvests with null fields.",
    "blank-date-silent-default": "On /stats, clearing the From or To field drops the parameter so the server silently uses this year's 1 Jan or 31 Dec, leaving the field blank while results use another range or showing 'The From date must be on or before the To date.'; triggered by clearing a date field, especially with the other date outside this year.",
    "stats-no-retry-after-error": "On /stats, the error state shows only a message with no Retry button, so recovering requires changing a date or reloading; triggered by making /api/stats/harvests fail.",
    "empty-months-omitted": "On /stats, the weight-by-month table only has columns for months with harvests, so empty months in the chosen range are silently skipped; triggered by choosing a range that includes months without harvests.",
    "long-plant-name-narrow-layout": "On /stats at 375 px width, a long unbroken plant name is truncated in Best plants and the nowrap table row header pushes all month and total columns out of view (or makes the page scroll sideways); triggered by creating a plant with a very long name and viewing the page on a narrow screen.",
    "dashboard-top-plant-ambiguous": "On the dashboard, the 'Top plant this year' card shows only the plant name and links to /stats, so same-named plants cannot be told apart; triggered by having two plants with the same name and viewing the dashboard.",
    "date-fields-ignore-url-changes": "On /stats, the date fields are read from the URL only at setup, so clicking the Stats nav link or using back/forward while on the page changes the URL but not the fields or data; triggered by picking a custom range and then navigating to /stats within the app."
  }
}
