  ],
  "issues": {
    "hx3": "On the plant detail page, when deleting a journal entry fails, the error is shown but the entry is removed from the list anyway, although it is still saved and returns on reload.",
    "hx4": "In the plants list and on the plant detail page, a plant's harvest count and harvested weight are multiplied by its number of journal entries because the journal join is not de-duplicated.",
    "create-retry-duplicate-entry": "POST /api/journal has no idempotency key or dedupe, so retrying Add entry on the plant page after a lost or timed-out response creates a duplicate entry.",
    "feed-long-plant-name-overflow": "On /journal at 375 px, a long unbroken plant name in the feed item link has no wrapping rule and makes the page scroll sideways.",
    "long-search-raw-validation-error": "Typing more than 80 characters into the /journal search box (no maxlength) makes the API return 422 and the page replaces results with a raw 'String should have at most 80 characters' message.",
    "malformed-journal-response-no-error": "When GET /api/journal returns a non-list body (object, string, HTML), the Journal page or plant journal section shows blank '–' entries or an empty/no-match state instead of a load error.",
    "plant-journal-capped-500": "The plant detail journal fetches at most 500 entries with no paging or notice, so older entries are unreachable while the badge shows the full count.",
    "journal-requests-no-timeout": "Journal fetches and mutations set no timeout, so when the API hangs the Add/Save button stays disabled on 'Saving…' or /journal stays on 'Loading entries…' indefinitely.",
    "control-chars-accepted-in-body": "POST /api/journal accepts and stores control characters such as an embedded NUL in the entry text, which are later rendered in the feed.",
    "implausible-old-dates-accepted": "POST/PUT /api/journal accepts implausible dates such as 0001-01-01, which are then shown as '1 Jan 1'.",
    "search-case-sensitive-non-ascii": "Journal search uses plain SQLite LIKE, so searching 'église' does not match an entry containing 'Église'.",
    "journal-load-error-no-retry": "When GET /api/journal fails, the /journal page and the plant detail journal section show only 'Could not load the journal.' with no Retry control, requiring a reload or search edit to recover.",
    "out-of-range-id-500": "Journal endpoints (POST plant_id, GET ?plant_id=, PUT/DELETE /api/journal/{id}) return 500 instead of 4xx when given integers larger than 64 bits.",
    "search-results-capped-50-misleading": "A /journal search matching more than 50 entries says '50 entries match' and silently drops the rest.",
    "today-timezone-mismatch": "The form defaults and limits the date to the browser's local today but the server validates against its own date.today(), so a user in a timezone ahead of the server gets 'Journal date cannot be in the future.' for today.",
    "body-limit-counts-utf16-units": "The journal entry form's maxlength and character counter count UTF-16 units, so emoji count double (about 250 fit) and server-accepted 500-emoji entries cannot be edited and saved.",
    "delete-of-missing-entry-errors-stale-list": "Deleting an entry that is already gone (second tab or retried delete) returns 404 'Journal entry not found.' as an error and the stale entry stays listed because the list only refreshes on success.",
    "failed-refresh-after-add-hides-list": "On the plant page, if adding an entry succeeds but the following journal refresh fails, the whole list is replaced by a load error with no retry while the badge count increases.",
    "search-no-debounce-stale-results": "The /journal search fires a request per keystroke with no debounce, so on a slow network an older response can overwrite newer results.",
    "search-box-not-synced-with-url": "On /journal?q=tom, clicking Journal in the nav or using back/forward changes the URL but the search box and results keep the old query.",
    "null-fields-rendered-raw": "When API fields are null, the plants list shows 'null journal entries' and journal feed items render with empty plant name and body and only '–' as date.",
    "nul-body-500": "POST/PUT /api/journal with a body starting with or consisting of a NUL character returns 500 because the SQLite length CHECK fails with an unhandled IntegrityError.",
    "edited-label-missing-same-second": "Editing a journal entry within the same second it was created shows no 'edited' label because timestamps have one-second resolution."
  }
}
