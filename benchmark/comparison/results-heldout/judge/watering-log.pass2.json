  "issues": {
    "hx5": "At 375px wide the Record past watering form on /beds keeps its three-column grid, so the Date and Litres inputs shrink to about 30px and their values cannot be seen or edited.",
    "hx6": "On /waterings, choosing a bed writes ?bed_id= to the URL while the page reads only ?bed=, so reloading or opening that link shows all beds again.",
    "today-timezone-mismatch": "When the browser's time zone is ahead of the server's, POST /api/waterings rejects the form's default date of today as in the future and Water now stores watered_on from the server's local date, so dates can disagree with the displayed time.",
    "table-overflow-long-bed-name": "On /waterings and the dashboard Recent waterings table at 375px, a long unbroken bed name does not wrap and the table makes the page scroll sideways.",
    "filter-response-out-of-order": "On /waterings, quickly switching the bed filter on a slow connection could let a late response for the previous bed overwrite the newer filter's results.",
    "no-request-timeout": "Watering requests (Water now, Save watering, Delete, list loads) set no timeout, so when the API hangs the button stays disabled on 'Watering…'/'Saving…' or the page stays loading indefinitely.",
    "huge-id-500": "Sending a bed_id or watering id beyond 64 bits to POST /api/waterings, GET /api/waterings?bed_id= or DELETE /api/waterings/{id} returns 500 instead of a 4xx.",
    "watering-load-error-no-retry": "When GET /api/waterings fails, the dashboard Recent waterings section and the /waterings page show only an error message with no retry control, so recovery requires a reload or filter change.",
    "beds-filter-error-silent": "On /waterings, if GET /api/beds fails the error is ignored and the Bed filter silently offers only 'All beds' with no message.",
    "tiny-litres-shown-zero": "Recording a watering with a tiny amount such as 0.001 L is accepted by the form and API but displayed as '0 L' in the notice and lists.",
    "ancient-date-accepted": "Recording a past watering dated year 0001 (or similar far past) is accepted with 201 and shown as '1 Jan 1' in the lists.",
    "water-now-double-click-duplicate": "Double-clicking Water now on /beds before the re-render sends two POSTs and records two waterings.",
    "no-idempotency-retry-duplicate": "POST /api/waterings has no idempotency key or dedupe, so retrying Water now or Save watering after a lost or timed-out response records a duplicate watering.",
    "shared-watering-busy-state": "On /beds a single shared wateringBedId (and shared notice/error) means watering a second bed re-enables the first bed's button while its request is pending, allowing duplicates and losing messages.",
    "deleted-watering-ids-reused": "Watering ids are reused after deleting the newest row, so a stale or retried DELETE /api/waterings/{id} can remove a different, newer watering.",
    "delete-retry-404-error": "Retrying a delete on /waterings after the first attempt succeeded returns 404 'Watering not found.' and shows it as an error, leaving the stale row.",
    "filter-not-synced-from-url": "On /waterings the bed filter is read from the URL only once, so navigating to /waterings via the nav link or back/forward leaves the old filter applied while the URL shows all beds.",
    "hang-stale-rows-under-filter": "On /waterings, when the request for a newly chosen bed hangs, the page stays on 'Loading waterings…' indefinitely while still listing the previous rows from other beds.",
    "waterings-page-crash-non-array": "When GET /api/waterings returns a non-array body, the /waterings page throws 'waterings.value?.reduce is not a function' and navigation stalls or the page sticks loading with no error.",
    "dashboard-malformed-response-no-error": "When GET /api/waterings?limit=5 returns a malformed body, the dashboard Recent waterings shows 'No waterings yet' or rows of 'Never' instead of an error.",
    "non-finite-litres-500": "POST /api/waterings with litres NaN, Infinity or 1e309/1e400 returns 500 instead of a 422 validation error.",
    "boolean-accepted-as-number": "POST /api/waterings accepts JSON true for litres or bed_id and stores it as 1 instead of returning 422.",
    "invalid-bed-query-raw-message": "Opening /waterings?bed=abc shows the raw validation text 'Query.bed id: Input should be a valid integer...' with a blank or mismatched filter select.",
    "unknown-bed-query-select-mismatch": "Opening /waterings?bed= with an unknown bed id shows 'No waterings for this bed' while the Bed select shows 'All beds'.",
    "beds-list-replaced-by-error-after-water-now": "On /beds, if the beds refresh after a successful Water now fails, the whole bed list is replaced by 'Could not load beds.' with no retry and the success notice is lost.",
    "water-now-success-despite-refresh-failure": "On /beds, Water now shows its success notice even when the following beds refresh fails, leaving 'Last watered' stale without any error.",
    "malformed-watering-fields-rendered-raw": "On /waterings and the dashboard, watering items with null or invalid fields are rendered as raw values such as 'garbage', 'x L', 'Never' and blank bed names.",
    "water-now-no-busy-label-form-open": "On /beds, clicking Water now while the bed's past-watering form is open disables the button without showing the 'Watering…' label."
  }
