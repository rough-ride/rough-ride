  "issues": {
    "hx5": "At 375px wide, the Record past watering form on /beds keeps its three-column grid, so the Date and Litres inputs shrink to about 30px and their values cannot be seen or edited.",
    "hx6": "On /waterings, choosing a bed writes ?bed_id= to the URL but the page reads only ?bed=, so reloading or opening that link shows all beds again.",
    "filter-not-synced-from-url": "On /waterings the bed filter is read from the URL only once, so going from /waterings?bed=N to /waterings via the nav link or Back keeps the old bed selected and the list filtered.",
    "beds-load-error-silent-in-filter": "On /waterings, when GET /api/beds fails the error is ignored and the Bed select silently offers only 'All beds' with no message or retry.",
    "boolean-litres-accepted": "POST /api/waterings with litres set to JSON true returns 201 and stores 1 litre instead of a 422.",
    "boolean-bed-id-accepted": "POST /api/waterings with bed_id set to JSON true returns 201 and records the watering on bed 1 instead of a 422.",
    "no-request-timeout": "Watering API calls have no timeout, so when the server hangs, 'Water now'/'Save watering' stay disabled on 'Watering…'/'Saving…' and lists stay loading indefinitely instead of failing after 10 s.",
    "year-one-date-accepted": "The past-watering form and POST /api/waterings accept implausible dates such as 0001-01-01, which are saved and listed as '1 Jan 1'.",
    "watering-load-error-no-retry": "When GET /api/waterings fails, the /waterings page and the dashboard 'Recent waterings' section show only an error message with no retry control, so recovery requires a reload or filter change.",
    "huge-int-id-500": "Watering endpoints (POST bed_id, GET ?bed_id=, DELETE /{id}) return 500 instead of 4xx for integers beyond 64 bits because SQLite overflows.",
    "nonfinite-litres-500": "POST /api/waterings with litres NaN, Infinity or an overflowing number like 1e309 returns 500 instead of a 422 validation error.",
    "waterings-page-crash-non-array": "When GET /api/waterings returns a non-array body, /waterings throws 'waterings.value?.reduce is not a function', navigation stalls or the page sticks on loading, and no error is shown.",
    "dashboard-non-array-shown-empty": "When the dashboard's GET /api/waterings?limit=5 returns a non-array object, 'Recent waterings' shows the 'No waterings yet' empty state instead of an error.",
    "dashboard-malformed-never-rows": "When the dashboard's recent-waterings response is a malformed non-list (e.g. a string), the table renders rows reading 'Never' with blank bed and '–' amount and no error.",
    "watering-ids-reused": "Watering ids use INTEGER PRIMARY KEY without AUTOINCREMENT, so after deleting the newest watering a new one reuses its id and a stale DELETE could remove it.",
    "create-not-idempotent": "POST /api/waterings has no idempotency key or dedupe, so retrying 'Water now' or 'Save watering' after a lost or timed-out response records a duplicate watering.",
    "double-click-water-now-duplicate": "Clicking 'Water now' twice quickly on /beds sends two POSTs before the button disables and records two waterings.",
    "delete-retry-404-error": "On /waterings, retrying a Delete whose first request already succeeded returns 404 'Watering not found.' and shows an error instead of being treated as done.",
    "unknown-bed-select-mismatch": "Opening /waterings?bed=<nonexistent id> shows 'No waterings for this bed' while the Bed select shows 'All beds', so filter control and results disagree.",
    "invalid-bed-query-raw-validation": "Opening /waterings?bed=abc shows the raw backend validation text 'Query.bed id: Input should be a valid integer...' with a select that does not match the URL.",
    "tiny-litres-shown-0l": "Litre amounts below 0.005 (e.g. 0.001) are accepted by the form and API but displayed as '0 L' in notices, the dashboard and /waterings.",
    "timezone-today-mismatch": "The server checks future dates and stamps 'Water now' dates using its own time zone while the form uses the browser's today, so users ahead of the server have today's date rejected and dates can disagree with displayed times.",
    "long-bed-name-table-overflow": "At 375px, a long unbroken bed name makes the watering tables on /waterings and the dashboard wider than the viewport, causing horizontal scrolling.",
    "hung-filter-stale-rows": "On /waterings, when the request for a newly chosen bed filter hangs, the page stays on 'Loading waterings…' and keeps listing other beds' rows under the selected bed.",
    "shared-watering-busy-state": "On /beds a single shared wateringBedId/notice/error state means starting 'Water now' on a second bed re-enables the first bed's button mid-request, allowing duplicate waterings and lost messages.",
    "water-now-no-progress-label-with-form-open": "On /beds, clicking 'Water now' while that bed's past-watering form is open disables the button but keeps the label 'Water now' with no 'Watering…' feedback.",
    "success-shown-when-refresh-fails": "On /beds, after 'Water now' succeeds but the follow-up beds refresh fails, the success notice is shown while 'Last watered' stays stale with no error.",
    "refresh-failure-replaces-bed-list": "On /beds, if GET /api/beds fails after a successful 'Water now', the bed list and success notice are replaced by 'Could not load beds.' with no retry.",
    "filter-late-response-race": "On /waterings, quickly switching the bed filter on a slow connection may let an earlier response overwrite the newer filter's results because there is no request ordering.",
    "malformed-watering-fields-rendered": "Waterings whose fields are null or malformed render as-is on /waterings and the dashboard (e.g. 'Never', blank bed, 'x L', raw 'garbage' date) instead of placeholders."
  }
}
