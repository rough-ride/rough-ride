  ],
  "issues": {
    "hx3": "On the plant detail page, a failed DELETE of a journal entry shows an error but removes the entry from the list anyway, although it is still saved and returns on reload.",
    "hx4": "In the plants list and on the plant page (GET /api/plants and /api/plants/{id}), a plant's harvest count and harvested weight are multiplied by its number of journal entries.",
    "journal-huge-id-500": "The journal endpoints (POST /api/journal, GET ?plant_id=, PUT/DELETE /api/journal/{id}) return 500 instead of a 4xx when given an integer id beyond 64 bits.",
    "search-over-80-raw-validation-error": "On /journal, typing more than 80 characters into the search box (which has no maxlength) replaces the results with the raw API validation message 'Query.q: String should have at most 80 characters'.",
    "implausible-ancient-date-accepted": "POST/PUT /api/journal accepts implausible dates such as 0001-01-01 and lists the entry as '1 Jan 1'.",
    "journal-load-error-no-retry": "When GET /api/journal fails, the /journal page and the plant page Journal section show only 'Could not load the journal.' with no Retry control, so recovery needs a reload or a search change.",
    "malformed-journal-response-not-shown-as-error": "When GET /api/journal returns a non-list body (an object, string or HTML), the /journal page and plant Journal section show an empty state or blank '–' entries instead of an error.",
    "journal-requests-no-timeout": "Journal requests have no timeout, so when the API hangs, Add/Save/Delete stay disabled on 'Saving…' and /journal stays on 'Loading entries…' indefinitely.",
    "long-plant-name-overflows-journal-feed": "On /journal at 375 px, a long unbroken plant name in a feed item has no overflow-wrap and pushes the page into horizontal scrolling.",
    "entry-length-counts-utf16-units": "The journal entry form counts the 500-character limit in UTF-16 units (maxlength and counter), so only about 250 emoji fit and server-accepted emoji entries cannot be saved when edited.",
    "search-case-sensitive-non-ascii": "Journal search uses SQLite LIKE, so searching 'église' does not match an entry containing 'Église'.",
    "add-retry-creates-duplicate-entry": "Retrying Add entry on the plant page after a lost or timed-out POST /api/journal response creates a duplicate entry because there is no idempotency key or dedupe.",
    "nul-in-body-500": "POST/PUT /api/journal with a body containing a NUL character returns 500 because the SQLite length CHECK constraint fails with an unhandled IntegrityError.",
    "control-characters-accepted-in-body": "POST /api/journal accepts and stores bodies containing control characters such as NUL (for example 'a\\u0000b') instead of rejecting or sanitising them.",
    "future-date-check-timezone-mismatch": "The server's not-in-future check uses its own date.today() while the form uses the browser's local date, so a user in a timezone ahead of the server can have today's entry rejected.",
    "plant-journal-silently-capped-at-500": "The plant detail page fetches journal entries with limit=500 and silently hides older ones while the badge shows the full count.",
    "search-results-silently-capped-at-50": "On /journal, search results are capped at 50 and the page says '50 entries match' with no indication that more exist.",
    "search-no-debounce-stale-results": "The /journal search fires a request per keystroke with no debounce, so on a slow network an older response can overwrite newer results.",
    "search-box-not-synced-with-url": "On /journal?q=tom, clicking Journal in the nav or using back/forward changes the URL to /journal but leaves the old search text and filtered results.",
    "edited-label-missing-same-second": "A journal entry edited within the same second it was created shows no 'edited' label because timestamps have one-second precision.",
    "null-fields-rendered-raw": "When API fields are null, the plants list shows 'null journal entries' and the journal feed shows empty plant name and body with only '–' for the date.",
    "refresh-failure-after-add-hides-list": "On the plant page, if adding an entry succeeds but the following journal list refresh fails, the whole entry list is replaced by a no-retry error while the badge count increases.",
    "delete-of-missing-entry-errors-and-leaves-stale-list": "Deleting a journal entry that is already gone (other tab or retry after a lost response) shows 'Journal entry not found.' and leaves the stale entry listed because the list is not refreshed on error."
  }
}
