  "issues": {
    "search-quote-crash": "Searching the journal (GET /api/journal?q=) for text containing an apostrophe such as it's returns a 500 and the Journal page shows 'Could not load the journal.', because the term is interpolated into the SQL.",
    "failed-save-clears-text": "On the plant detail page, when POST /api/journal fails after clicking 'Add entry', the error is shown but the typed entry text is cleared from the textarea.",
    "journal-requests-no-timeout": "Journal requests (add, edit, delete, list/search) have no 10 s timeout, so when the API hangs the button stays on 'Saving…' or the page on 'Loading entries…' indefinitely.",
    "search-case-sensitive-non-ascii": "Journal search matches case-insensitively only for ASCII letters, so searching 'épinards' does not find an entry containing 'ÉPINARDS'.",
    "add-retry-creates-duplicate": "POST /api/journal has no idempotency key, so retrying 'Add entry' after a lost or timed-out response that the server already committed creates a duplicate entry.",
    "delete-retry-shows-not-found": "Retrying a journal entry delete whose first request already succeeded returns 404 and the plant page shows 'Journal entry not found.' as an error, leaving the stale entry listed.",
    "entry-limit-counts-utf16-units": "The journal entry form's maxlength and character counter count UTF-16 code units, so emoji count double, new entries stop at about 250 emoji, and editing a server-accepted emoji-heavy entry is refused with 'Keep the entry to 500 characters.'",
    "plant-journal-capped-at-500": "The plant detail page fetches the journal with limit=500 and no paging, so a plant with more than 500 entries silently hides older ones while the badge shows the full count.",
    "search-like-wildcards-unescaped": "Journal search does not escape LIKE wildcards, so searching for '%' or '_' returns every entry instead of only entries containing that character.",
    "huge-id-500": "Journal endpoints (POST plant_id, GET ?plant_id=, PUT/DELETE /api/journal/{id}) return 500 instead of a 4xx when given an integer id beyond SQLite's 64-bit range.",
    "journal-load-error-no-retry": "When GET /api/journal fails, the /journal page and the plant detail Journal section show only 'Could not load the journal.' with no retry control, so recovery requires a reload or changing the search.",
    "future-date-check-timezone-mismatch": "The 'no future dates' check compares against the server's date.today() while the form uses the browser's local date, so a user in a time zone ahead of the server can have today's entry rejected as in the future.",
    "journal-feed-long-plant-name-overflow": "On /journal at 375 px width, a long unbroken plant name in the feed (.journal-feed__plant has no overflow-wrap) makes the page scroll sideways.",
    "search-over-80-raw-validation-error": "Typing more than 80 characters into the /journal search box (which has no maxlength) replaces the results with a raw validation message like 'Query.q: String should have at most 80 characters'.",
    "journal-accepts-year-0001": "POST/PUT /api/journal accept implausible dates such as 0001-01-01, which are stored and shown as '1 Jan 1' at the bottom of the list.",
    "nul-body-500": "A journal body containing a NUL character passes validation but fails the database CHECK constraint, so POST/PUT /api/journal return 500 instead of a 4xx.",
    "journal-search-ignores-url-changes": "The /journal search box is initialized from ?q= only once and does not follow later URL changes, so Back/Forward navigation leaves the box and results out of sync with the URL.",
    "edited-marker-same-second": "An entry edited within the same second it was created does not show the 'edited' marker, because the timestamps have one-second resolution and compare equal.",
    "malformed-journal-response-shown-empty": "When GET /api/journal returns 200 with a non-list body, the Journal page shows '0 entries' and the 'No journal entries yet' empty state instead of an error.",
    "journal-stale-count-on-error": "On /journal, when a later search request fails, the results count from the previous successful load still shows above the error message.",
    "edit-refresh-failure-clears-list": "On the plant detail page, if saving an edit succeeds but the follow-up GET /api/journal refresh fails, the whole entry list disappears and only 'Could not load the journal.' is shown.",
    "beds-delete-button-stays-disabled": "Automated runs report that after various injected failures (POST /api/beds, POST /api/plants, POST/PUT /api/journal, 401, 375 px viewport), navigating to /beds leaves a bed's Delete control disabled for over 10 s.",
    "beds-load-failure-clears-name": "On /beds, after GET /api/beds fails with 500, the typed bed Name is cleared and the page does not recover on retry (the 'Add plant to Bed' link never appears).",
    "plants-list-load-error-no-retry": "On /plants, after GET /api/plants fails with 500, there is no retry path without a page reload and the expected plant links never appear.",
    "plant-detail-load-error-no-retry": "On /plants/{id}, after GET /api/plants/{id} (or a related GET) fails with 500, the page offers no way to retry without a full reload."
  }
}
