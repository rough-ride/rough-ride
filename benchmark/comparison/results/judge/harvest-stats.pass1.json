  "issues": {
    "error-shown-as-empty": "When GET /api/stats/harvests fails (5xx, network error, or a 422 such as an inverted range or invalid date), the /stats page shows the 'No harvests in this range' empty state instead of an error message.",
    "to-date-excluded": "GET /api/stats/harvests filters with harvested_on < To, so a harvest logged on the To date (including 31 Dec for the dashboard's this-year top plant) is left out of the /stats table, totals and best plants.",
    "delete-bed-control-stays-disabled": "In automated fault-injection runs, after a failure or reload on various pages, navigating to /beds leaves a DeleteBed control disabled for more than 10 seconds.",
    "stats-no-retry-after-error": "When the stats request fails, /stats offers no Retry control, so the user must change a date or reload the page to refetch the same range after the server recovers.",
    "stats-no-request-timeout": "useApiFetch sets no timeout, so if GET /api/stats/harvests hangs, /stats shows 'Loading stats…' (or blocks navigation to Stats) indefinitely instead of failing after 10 seconds.",
    "stats-raw-validation-message-for-invalid-url-date": "Opening /stats with an impossible but well-formed date such as ?from=2026-02-30 shows a raw 'Query.from: Input should be a valid date...' message and a blank From field, because queryDate() only checks the regex.",
    "stats-date-fields-ignore-url-changes": "On /stats the From/To fields are read from the URL only at setup, so pressing Back or clicking the Stats nav link changes the URL but leaves the old range shown.",
    "stats-cleared-date-silent-default": "Clearing the From or To field on /stats drops it from the query and the server silently uses the current-year bound, so the blank input disagrees with the range used and can yield a confusing 'From must be on or before To' error.",
    "stats-empty-months-omitted": "The /stats per-month table only has columns for months that have harvests, so months in the chosen range with no harvests are missing rather than shown as zero.",
    "stats-null-fields-rendered": "When GET /api/stats/harvests returns null fields in a 200 response, /stats renders text such as 'null harvests from – to –' and a nameless table row.",
    "stats-malformed-200-not-handled": "When GET /api/stats/harvests returns a malformed or non-JSON 200 response (e.g. '{}' or an HTML body), /stats throws a render error or shows a garbage table instead of an error state.",
    "stats-partial-date-typing-fires-requests": "Typing a year digit by digit in a /stats date input fires a request per keystroke, and intermediate dates earlier than From flash a 422 validation error.",
    "stats-best-plants-long-text-overflow": "A plant with a long unbroken name or variety overflows the Best plants cards on /stats at 375 px, causing sideways page scrolling.",
    "stats-table-long-plant-name-hides-columns": "A long unbroken plant name in the /stats table's nowrap row header pushes all weight columns out of view at 375 px.",
    "dashboard-undefined-on-malformed-summary": "When GET /api/dashboard/summary returns malformed JSON, the dashboard renders the text 'undefined'.",
    "dashboard-nan-on-malformed-tasks": "When GET /api/tasks/upcoming returns malformed JSON, the dashboard renders the text 'NaN'.",
    "login-no-retry-after-failure": "After POST /api/auth/login fails (500, reset, 400, 429), retrying from /login does not reach the Dashboard without a page reload.",
    "auth-me-no-retry-after-failure": "After GET /api/auth/me fails on /login, there is no way to retry without a page reload.",
    "dashboard-tasks-no-retry-after-failure": "After GET /api/tasks/upcoming fails on the dashboard, there is no way to retry without a page reload.",
    "dashboard-summary-no-retry-after-failure": "After GET /api/dashboard/summary fails on the dashboard, there is no way to retry without a page reload.",
    "stats-signed-out-reload-request-in-flight": "After a signed-out reload of /stats, a request is still in flight after 10 seconds."
  }
}
