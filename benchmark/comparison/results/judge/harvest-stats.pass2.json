  "issues": {
    "to-date-excluded": "Harvests dated on the To date (including 31 Dec in the default range and the dashboard's top plant this year) are left out of the /stats table, totals and best plants because the query uses an exclusive upper bound; trigger by choosing a range whose To date has a harvest.",
    "error-shown-as-empty": "When GET /api/stats/harvests fails (5xx, network error, or 422 for an invalid or inverted range), the /stats page shows the 'No harvests in this range' empty state instead of an error message.",
    "stats-no-request-timeout": "The stats request on /stats has no 10 s timeout, so when the API hangs the page shows 'Loading stats…' (or the previous range's data, or stays on the previous page) indefinitely; trigger by making /api/stats/harvests never respond.",
    "stats-no-retry-after-error": "The /stats error state offers no Retry control, so after a failed stats request the user must change a date or reload the page to refetch; trigger by making /api/stats/harvests fail and then recover.",
    "stats-cleared-date-hidden-default": "Clearing the From or To field on /stats drops it from the query so the server silently uses 1 Jan or 31 Dec of the current year while the input stays blank, which can yield a contradictory 'From must be on or before To' error when the other date is in an earlier year.",
    "stats-invalid-url-date-raw-message": "Opening /stats with an impossible date in the URL (e.g. ?from=2026-02-30) leaves the field blank and shows the raw technical 'Query.from: Input should be a valid date...' validation message.",
    "stats-empty-months-omitted": "The per-month table on /stats only has columns for months that contain harvests, so months with no harvests in the chosen range are missing; trigger with any range spanning months without harvests.",
    "best-plants-long-text-overflow": "On /stats at 375 px, a long unbroken plant name or variety in the Best plants cards overflows the card and makes the page scroll sideways.",
    "stats-table-long-plant-name-nowrap": "On /stats at 375 px, a very long unbroken plant name in the nowrap Plant column pushes every month and Total column out of view inside the table.",
    "stats-fetch-per-keystroke-error-flash": "Typing a date digit by digit in the /stats date inputs fires a request for every intermediate value, and intermediate ranges briefly flash the 'From must be on or before To' error.",
    "stats-dates-ignore-url-changes": "The /stats date fields are read from the URL only at setup, so Back/Forward or clicking the Stats nav link changes the URL without updating the fields or results.",
    "stats-null-fields-rendered": "When the stats response contains null fields, /stats renders literal text such as 'null harvests from – to –' and a row with no plant name; trigger with a mocked response containing nulls.",
    "stats-malformed-200-not-handled": "A malformed or non-JSON stats response (HTML body, '{}', malformed JSON) is not treated as an error on /stats, causing a render crash with the dev error overlay or a garbage/stale table instead of an error state.",
    "stats-request-in-flight-after-signed-out-reload": "After a signed-out reload of /stats, a request is still in flight after 10 s according to the automated settles check.",
    "beds-delete-control-stays-disabled": "Automated 'settles' checks report that a DeleteBed control on /beds stays disabled after 10 s following failed requests, reloads or viewport changes on various pages, sometimes alongside lost form values or failed retry steps.",
    "login-no-retry-after-failure": "On /login, after POST /api/auth/login or GET /api/auth/me fails (500, 400, 429, reset), the automated check finds no way to recover without reloading.",
    "dashboard-no-retry-after-failure": "On the dashboard (/), after GET /api/tasks/upcoming or GET /api/dashboard/summary fails (500, 400, 429, reset), the automated check finds no retry path without reloading.",
    "dashboard-nan-on-malformed-tasks": "The dashboard (/) shows the text 'NaN' when GET /api/tasks/upcoming returns malformed JSON.",
    "dashboard-undefined-on-malformed-summary": "The dashboard (/) shows the text 'undefined' when GET /api/dashboard/summary returns malformed JSON."
  }
}
