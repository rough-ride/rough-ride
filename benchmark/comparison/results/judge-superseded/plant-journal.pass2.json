  "issues": {
    "search-quote-crash": "Searching the journal (GET /api/journal?q=) for text containing an apostrophe such as it's returns a 500 and the Journal page shows 'Could not load the journal.', because the term is interpolated into the SQL.",
    "failed-save-clears-text": "On the plant detail page, when POST /api/journal fails while adding an entry, the error is shown but the typed entry text is cleared from the textarea.",
    "journal-requests-no-timeout": "Journal requests (add, edit, delete, list, search) have no 10 s timeout, so when the API hangs the button stays disabled on 'Saving…' or the list stays on 'Loading entries…' indefinitely.",
    "add-retry-creates-duplicate": "Retrying 'Add entry' after the POST /api/journal reached the server but the response was lost or reported as failed creates a second identical entry because the POST has no idempotency or dedupe.",
    "delete-retry-shows-not-found": "Retrying a journal entry delete after a lost response, or deleting an already-deleted entry, returns 404 and the plant page shows 'Journal entry not found.' instead of treating it as success and refreshing the list.",
    "search-non-ascii-case-sensitive": "Journal search folds case only for ASCII letters, so searching 'épinards' does not match an entry containing 'ÉPINARDS'.",
    "plant-journal-capped-at-500": "The plant detail page fetches journal entries with limit=500 and no paging, so for a plant with more than 500 entries the older ones are not shown while the count badge shows the full total.",
    "search-like-wildcards-unescaped": "Searching the journal for '%' or '_' returns all entries because LIKE wildcards in the search term are not escaped.",
    "emoji-utf16-length-mismatch": "The journal entry form's maxlength and character counter count UTF-16 units while the server counts code points, so emoji entries are capped at about 250 characters and an existing entry with many emoji cannot be re-saved when edited.",
    "huge-id-returns-500": "Sending an integer id above 64-bit range as plant_id or entry id to the journal endpoints (POST, GET ?plant_id=, PUT, DELETE) returns a 500 instead of a 4xx.",
    "journal-load-error-no-retry": "When GET /api/journal fails, the Journal page and the plant detail Journal section show only 'Could not load the journal.' with no retry control, so recovery requires a reload or changing the search.",
    "today-timezone-mismatch": "The no-future-date check uses the server's date.today() while the form defaults to the browser's local date, so a user in a time zone ahead of the server can have an entry dated today rejected as in the future.",
    "long-plant-name-overflows-feed": "On /journal at a 375 px viewport, a plant name that is one long unbroken word makes the feed card and page scroll sideways because .journal-feed__plant has no overflow-wrap.",
    "search-over-80-raw-validation-error": "Typing more than 80 characters into the Journal search box replaces the results with a raw 422 message like 'Query.q: String should have at most 80 characters', and the input has no maxlength.",
    "ancient-date-accepted": "The journal accepts implausible dates such as 0001-01-01 via the form or POST/PUT /api/journal, storing the entry and showing it as '1 Jan 1' at the bottom of the list.",
    "nul-body-returns-500": "Creating or updating a journal entry whose body contains a NUL character returns a 500 because SQLite's length() check fails with an unhandled IntegrityError.",
    "search-not-synced-with-url": "The /journal search box is initialised from ?q= only once, so using browser Back/Forward or in-app URL changes leaves the search box and results out of sync with the URL.",
    "edited-marker-missing-same-second": "An entry edited within the same second it was created is not marked 'edited' because created_at and updated_at have one-second resolution and compare equal.",
    "malformed-response-shown-as-empty": "When GET /api/journal returns 200 with a non-list body, the Journal page shows '0 entries' and the 'No journal entries yet' empty state instead of an error.",
    "stale-count-beside-load-error": "On /journal, when a later search request fails, the previous result count stays visible above the load error because the count is not hidden when loadError is set.",
    "edit-refresh-failure-clears-list": "On the plant detail page, after a successful edit, if the follow-up GET /api/journal refresh fails the whole entry list disappears and only 'Could not load the journal.' is shown, ignoring the saved entry from the PUT response.",
    "delete-bed-control-stays-disabled": "Automated resilience checks report that after a mocked 500 on one of various requests (journal, plants, beds), navigating to /beds leaves a DeleteBed control disabled for over 10 s."
  }
}
