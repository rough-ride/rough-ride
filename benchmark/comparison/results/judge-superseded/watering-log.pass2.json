  "issues": {
    "water-now-twice": "Double-clicking 'Water now' on the beds page sends two POST /api/waterings requests and records two waterings, because the button is not disabled while the request is in flight.",
    "negative-litres": "The beds page 'Record past watering' form and POST /api/waterings accept a negative litres amount such as -5 (no lower bound), saving it and listing it as a negative amount.",
    "huge-int-id-500": "POST /api/waterings, GET /api/waterings?bed_id= and DELETE /api/waterings/{id} return 500 when given an integer id larger than 64 bits, such as 99999999999999999999, because it overflows SQLite.",
    "litres-nonfinite-500": "POST /api/waterings returns 500 instead of 422 when litres is NaN or an infinite value such as 1e400.",
    "ancient-date-accepted": "POST /api/waterings and the past-watering form accept implausibly old dates such as 0001-01-01, which are saved with 201 and listed as '1 Jan 1'.",
    "tiny-litres-shown-zero": "Recording a past watering with a tiny amount such as 0.001 litres is accepted by the form and API and then displayed as '0 L' in the lists and success notice.",
    "shared-watering-busy-flag": "On the beds page a single shared wateringBedId is used for all beds, so watering a second bed while the first request is pending re-enables the first bed's button (and clears the other's busy state and messages), allowing a duplicate submit.",
    "waterings-error-no-retry": "When GET /api/waterings fails, the /waterings page and the dashboard 'Recent waterings' section show only an error message with no Retry control, so recovery requires a page reload.",
    "waterings-malformed-json-uncaught": "When GET /api/waterings returns malformed JSON, the /waterings page throws an uncaught error that triggers the dev error overlay.",
    "watering-requests-no-timeout": "The watering requests (Water now, Save watering, list load, delete) have no 10 s timeout, so if the API hangs the button stays on 'Watering…'/'Saving…' or the list stays on 'Loading waterings…' indefinitely with no error.",
    "waterings-beds-error-silent": "On /waterings a failed GET /api/beds is ignored, so the bed filter silently shows only 'All beds' with no error message or retry.",
    "invalid-bed-query-raw-error": "Opening /waterings?bed=abc shows the raw validation text 'Query.bed id: Input should be a valid integer...' and a blank filter select instead of a friendly message or fallback.",
    "long-bed-name-table-overflow": "A long bed name without spaces makes the waterings tables on /waterings and the dashboard overflow horizontally at a 375 px viewport because the cells do not wrap.",
    "delete-already-deleted-error": "Deleting a watering that was already deleted (second tab or retry after timeout) shows a 404 'Watering not found.' error on /waterings instead of treating it as done and refreshing the list.",
    "watering-post-no-idempotency": "POST /api/waterings has no idempotency key or deduplication, so retrying Water now or Save watering after a lost or timed-out response records a duplicate watering.",
    "server-timezone-date-mismatch": "The future-date check and the Water now watered_on use the server's local date while the client uses the browser's date and watered_at is UTC, so a user ahead of the server's time zone has today's date refused as 'in the future' and entries can land on the wrong day.",
    "beds-refresh-failure-hides-watering": "On the beds page, if the POST /api/waterings succeeds but the follow-up GET /api/beds refresh fails, the bed list is replaced by 'Could not load beds.' (or the save is reported as failed), hiding the confirmation and inviting a duplicate retry.",
    "litres-boolean-accepted": "POST /api/waterings accepts the boolean true as litres and stores it as 1.0 L instead of returning 422.",
    "beds-malformed-json-add-bed-stuck": "On /beds, when GET /api/beds returns malformed JSON, a render error is logged and the 'Add bed' button stays disabled on 'Adding…'.",
    "beds-500-add-bed-values-lost": "On /beds, when GET /api/beds fails with 500 after adding a bed, the typed Name value is cleared and the page does not recover without a reload.",
    "dashboard-waterings-no-loading-state": "The dashboard 'Recent waterings' section has no loading state, so during a slow client-side GET /api/waterings it shows only its heading.",
    "ssr-datetime-timezone-hydration-mismatch": "formatDateTime sets no fixed time zone, so watering times rendered on the SSR server differ from the client's zone, causing a hydration mismatch or wrong time on first paint.",
    "waterings-filter-ignores-url-change": "On /waterings the bed filter is read from route.query only once, so navigating to /waterings without a query or using back/forward leaves the old filter applied while the URL changes.",
    "waterings-filter-stale-results": "On /waterings, changing the bed filter quickly or while a refetch fails can leave a previous filter's rows displayed (alongside the error or overwriting newer results).",
    "waterings-navigation-blocked-on-hang": "Clicking the Waterings nav link while GET /api/waterings hangs leaves the previous page on screen indefinitely with no loading indication, because the page awaits the fetch at top level.",
    "water-now-busy-hidden-with-past-form-open": "On the beds page, when the past-watering form for a bed is open, its 'Water now' button keeps reading 'Water now' during a request, so repeated clicks each record another watering.",
    "huge-litres-amount-overflows-layout": "A stored extreme litres value such as -1e308 renders as a several-hundred-digit number on /waterings and the dashboard, forcing horizontal scrolling at 375 px."
  }
}
