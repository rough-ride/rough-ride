  "issues": {
    "error-shown-as-empty": "On /stats, any failed GET /api/stats/harvests (5xx, network error, or a 422 from an invalid or inverted range) is rendered as the 'No harvests in this range' empty state instead of an error message.",
    "to-date-excluded": "GET /api/stats/harvests and top_plants filter with harvested_on < To, so a harvest dated on the To date (including 31 Dec in the default range and the dashboard top plant) is left out of the table, totals and best plants.",
    "stats-no-request-timeout": "On /stats, useApiFetch sets no timeout, so when GET /api/stats/harvests hangs the page shows 'Loading stats…' (or blocks navigation) indefinitely instead of failing after 10 s.",
    "stats-no-retry-after-error": "On /stats, when loading the stats fails the error state offers no Retry control, so the same range can only be refetched by changing a date or reloading the page.",
    "stats-table-long-plant-name-nowrap": "On /stats at 375 px, a long unbroken plant name in the nowrap row header widens the Plant column so all month and Total columns are pushed out of view inside the table scroller.",
    "best-plants-long-text-overflow": "On /stats at 375 px, a long unbroken plant name or variety in the Best plants cards (.stat__value/.stat__hint) has no wrapping and overflows, making the page scroll sideways.",
    "stats-invalid-url-date-raw-message": "Opening /stats with a regex-valid but impossible date in the URL (e.g. ?from=2026-02-30) shows the raw 'Query.from: Input should be a valid date...' validation text and a blank From field.",
    "stats-cleared-date-silent-default": "Clearing the From or To field on /stats drops the parameter so the server silently uses 1 Jan or 31 Dec of the current year while the input stays blank, which can yield a contradictory 'From must be on or before To' error.",
    "stats-empty-months-omitted": "The /stats per-month table (from GET /api/stats/harvests) only has columns for months with harvests, so months without harvests in the chosen range are missing instead of shown as zero.",
    "stats-date-typing-fetch-per-keystroke": "Typing a year into a /stats date input fires a request for each intermediate value (e.g. 0002-12-31) and briefly flashes a 422 'From must be on or before To' error, because there is no debounce.",
    "stats-dates-ignore-url-changes": "On /stats the From/To fields are read from the URL only at setup, so Back/Forward or clicking the Stats nav link changes the URL but the page keeps the old range.",
    "stats-malformed-response-rendered-as-data": "When GET /api/stats/harvests returns 200 with null fields or a non-JSON body, /stats renders it as data, e.g. 'null harvests from – to –' and an empty table, instead of an error state.",
    "stats-malformed-response-crash": "When GET /api/stats/harvests returns 200 with '{}', HTML, or null months, rendering /stats throws (stats.plants.length / formatMonth(null)) and the previous page content stays on screen at URL /stats.",
    "beds-delete-control-stays-disabled": "In automated runs across many triggers, after navigating to /beds the DeleteBed control stays disabled for more than 10 s and some retry-recovery steps then fail.",
    "dashboard-signin-no-retry-without-reload": "When GET /api/dashboard/summary, GET /api/tasks/upcoming or POST /api/auth/login fails with 500 on the sign-in or dashboard flow, the automated check finds no way to recover without reloading the page.",
    "undefined-text-after-api-failure": "When GET /api/auth/me fails with 500 or GET /api/dashboard/summary returns malformed JSON, the page renders the literal text 'undefined'.",
    "signin-uncaught-render-error": "When GET /api/auth/me fails with 500 on /login, a Vue unhandled render error and the dev error overlay appear.",
    "stats-request-in-flight-after-429": "After GET /api/stats/harvests is answered with 429 on /stats, reloading the page leaves a request still in flight after 10 s."
  }
}
