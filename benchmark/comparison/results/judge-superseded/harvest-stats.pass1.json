  "issues": {
    "error-shown-as-empty": "On /stats, any failed stats request (5xx, network error, 422 for an inverted or invalid range) is rendered as the 'No harvests in this range' empty state instead of an error message.",
    "to-date-excluded": "GET /api/stats/harvests and top_plants use an end-exclusive filter, so harvests dated on the To date (including 31 Dec for the dashboard's top plant) are left out of the table, totals and best plants when a range ending on a harvest date is chosen.",
    "stats-no-retry-after-error": "When loading stats fails on /stats, the error state offers no Retry control, so after the server recovers the user must change a date or reload the page to refetch.",
    "stats-no-request-timeout": "Stats requests from /stats (via useApiFetch) set no timeout, so when the API hangs the page shows 'Loading stats…' (or blocks navigation) indefinitely instead of failing after 10 s.",
    "invalid-url-date-raw-validation-message": "Opening /stats with a regex-valid but impossible date in the URL (e.g. ?from=2026-02-30) leaves the From field blank and shows the raw 'Query.from: Input should be a valid date…' API message.",
    "date-fields-ignore-url-changes": "On /stats the From/To fields are read from the URL only at setup, so Back/Forward or clicking the Stats nav link changes the URL but leaves the old range in the fields and results.",
    "cleared-date-silent-default": "Clearing the From or To field on /stats drops the parameter and the server silently uses the current year's bound, so the blank field disagrees with the results and can produce a confusing 'From must be on or before To' error when the other date is in an earlier year.",
    "months-without-harvests-omitted": "The /stats per-month table only has columns for months containing harvests, so months with no harvests in the chosen range (e.g. the default full year) are missing rather than shown as zero.",
    "stats-malformed-response-renders-garbage": "When GET /api/stats/harvests returns 200 with null fields or a non-JSON body, /stats renders text like 'null harvests from – to –' and an empty, broken table instead of an error.",
    "stats-crash-on-malformed-response": "When GET /api/stats/harvests returns 200 with '{}', an HTML body or null month values, rendering /stats throws (e.g. reading stats.plants.length), leaving the previous page on screen with a Nuxt error dialog.",
    "partial-date-typing-fires-requests": "Typing a year digit by digit in a /stats date input fires a request for each intermediate date with no debounce, briefly flashing the 422 'From must be on or before To' error.",
    "best-plants-long-text-overflow": "A plant with a long unbroken name or variety makes the Best plants cards on /stats overflow at 375 px width, causing sideways page scrolling.",
    "stats-table-long-plant-name-hides-columns": "A plant with a long unbroken name makes the nowrap Plant column of the /stats table wider than the card at 375 px, pushing every weight column out of view.",
    "beds-delete-control-stays-disabled": "Automated checks report that after various injected failures or reloads, navigating to /beds finds a DeleteBed control still disabled after 10 s (and some follow-up retry steps not visible).",
    "dashboard-malformed-summary-shows-undefined": "When GET /api/dashboard/summary returns malformed JSON, the dashboard renders the literal text 'undefined'.",
    "auth-me-failure-shows-undefined": "When GET /api/auth/me fails with 500 on sign-in, the page renders the literal text 'undefined'.",
    "auth-me-failure-render-crash": "When GET /api/auth/me fails with 500 on sign-in, an unhandled render error occurs and the dev error overlay appears.",
    "dashboard-tasks-no-retry-after-error": "When GET /api/tasks/upcoming fails with 500 on the dashboard, there is no way to retry without reloading the page.",
    "dashboard-summary-no-retry-after-error": "When GET /api/dashboard/summary fails on the dashboard, there is no way to retry without a reload (one run also hit an unhandled render error).",
    "login-no-retry-after-error": "When POST /api/auth/login fails with 500 on /login, there is no way to retry without reloading the page.",
    "stats-429-request-stays-in-flight": "When GET /api/stats/harvests is rate limited (429), a reload of /stats leaves a request still in flight after 10 s and no retry path."
  }
}
