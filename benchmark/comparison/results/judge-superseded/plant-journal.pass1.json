  "issues": {
    "search-quote-crash": "Searching the journal (GET /api/journal?q=) for text containing an apostrophe such as it's returns a 500 and the Journal page shows 'Could not load the journal.', because the term is interpolated into the SQL.",
    "failed-save-clears-text": "On the plant detail page, when POST /api/journal fails while adding an entry, the error is shown but the typed entry text is cleared from the textarea.",
    "journal-add-retry-duplicates": "Retrying Add entry after the POST /api/journal response is lost or times out creates a second identical entry because creation has no idempotency key or duplicate check.",
    "journal-delete-retry-404": "Deleting a journal entry that was already deleted (retry after a lost response or another tab) returns 404 and the plant page shows 'Journal entry not found.' while the stale entry stays listed.",
    "journal-emoji-utf16-limit": "The journal entry form's maxlength and character counter count UTF-16 units, so emoji count as two, new entries stop at about 250 emoji, and existing server-accepted emoji entries cannot be re-saved.",
    "journal-today-timezone-mismatch": "For a browser in a time zone ahead of the server, adding an entry dated the browser's today is rejected with 'Journal date cannot be in the future.' because the server checks against its own date.today().",
    "beds-control-stays-disabled-after-500": "Automated resilience checks report that after a mocked 500 on a plants, beds or journal request, navigating to /beds leaves a DeleteBed control disabled for over 10 seconds.",
    "journal-feed-long-name-overflow": "On /journal at 375 px width, a plant name that is one long unbroken word does not wrap in the feed item and makes the page scroll sideways.",
    "journal-search-over-80-raw-error": "Typing more than 80 characters into the /journal search box replaces the results with a raw validation message such as 'Query.q: String should have at most 80 characters', and the input has no maxlength.",
    "journal-search-like-wildcards": "Searching the journal for '%' or '_' returns every entry because the characters act as unescaped SQL LIKE wildcards.",
    "journal-load-error-no-retry": "When GET /api/journal fails, the /journal page and the plant detail Journal section show only 'Could not load the journal.' with no retry control, so recovery needs a reload or a search change.",
    "journal-huge-id-500": "Sending a plant_id or entry id larger than 64 bits to POST, GET, PUT or DELETE journal endpoints returns 500 Internal Server Error instead of a 4xx.",
    "journal-requests-no-timeout": "Journal requests have no client timeout, so when the API hangs, Add, Save or Delete stays on 'Saving…' and disabled, or the list stays on 'Loading entries…', indefinitely.",
    "journal-date-no-lower-bound": "POST or PUT /api/journal accepts implausible dates such as 0001-01-01, stores them and shows them as '1 Jan 1' at the bottom of the list.",
    "plant-journal-capped-at-500": "The plant detail page fetches journal entries with limit=500 and no paging, so for plants with more than 500 entries the older ones are not shown while the badge shows the full count.",
    "journal-search-non-ascii-case-sensitive": "Journal search is case-sensitive for non-ASCII letters, so searching 'épinards' does not match 'ÉPINARDS'.",
    "journal-nul-body-500": "Posting or putting a journal entry whose body starts with a NUL character returns 500 because the SQLite length CHECK constraint fails unhandled.",
    "journal-edit-refresh-failure-clears-list": "On the plant page, after a successful entry edit, a failed journal list refresh removes the whole list and shows only 'Could not load the journal.'.",
    "journal-edited-marker-same-second": "An entry edited within the same second it was created is not marked 'edited' because the timestamps have one-second resolution.",
    "journal-malformed-response-shown-empty": "When GET /api/journal returns 200 with a non-list body, the Journal page shows '0 entries' and 'No journal entries yet' instead of an error.",
    "journal-add-refresh-failure-reported-as-failed": "On the plant page, if the refresh after a successful POST /api/journal fails, Add entry reports 'Could not add the entry' and resubmitting creates a duplicate.",
    "journal-search-url-not-synced": "On /journal the search box is read from ?q= only once, so browser Back/Forward or in-app URL changes leave the box and results out of sync with the URL.",
    "journal-stale-count-with-error": "On /journal, when a later search request fails, the previous results count is still shown above the load error."
  }
}
