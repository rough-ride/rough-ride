  "issues": {
    "water-now-twice": "On /beds, double-clicking or repeatedly clicking a bed's 'Water now' button records one watering per click because the button is never disabled while its POST /api/waterings is in flight.",
    "negative-litres": "The past-watering form on /beds and POST /api/waterings accept a negative litres value such as -5, save it with 201 and list it as a negative amount.",
    "huge-id-500": "POST /api/waterings, GET /api/waterings?bed_id= and DELETE /api/waterings/{id} return 500 Internal Server Error when given an integer id larger than 64 bits such as 99999999999999999999.",
    "nonfinite-litres-500": "POST /api/waterings returns 500 Internal Server Error instead of 422 when litres is a non-finite value such as 1e400 (infinity) or NaN.",
    "litres-boolean-accepted": "POST /api/waterings with litres set to boolean true returns 201 and stores 1.0 litres instead of rejecting it with 422.",
    "tiny-litres-shown-zero": "A past watering with a tiny positive amount such as 0.001 L is accepted by the form and API, then shown as '0 L' on the notice, dashboard and /waterings because the display rounds to 2 decimals.",
    "watering-date-no-lower-bound": "The past-watering form and POST /api/waterings accept an implausible date such as 0001-01-01 with 201 and the lists show it as '1 Jan 1'.",
    "server-timezone-date-mismatch": "When the browser's time zone is ahead of the server's, recording a past watering with the default date (browser today) is refused as 'in the future', and 'Water now' stores watered_on as the server's local date alongside a UTC watered_at.",
    "ssr-time-zone-hydration-mismatch": "Watering timestamps on the beds, dashboard and waterings pages are formatted without a fixed time zone, so viewing them from a browser in a different zone than the Nuxt server can cause a hydration mismatch or wrong first-paint time.",
    "requests-no-timeout": "Watering requests (Water now, Save watering, the /waterings list, dashboard and delete) have no 10 s timeout, so when the API hangs the button stays disabled on 'Watering…'/'Saving…' or the list stays on 'Loading waterings…' indefinitely.",
    "watering-retry-duplicate": "POST /api/waterings has no idempotency key or dedupe, so retrying 'Water now' or 'Save watering' after a slow, lost or timed-out response records a second watering.",
    "shared-watering-busy-state": "On /beds a single shared wateringBedId and notice/error state is used for all beds, so clicking 'Water now' on a second bed while the first is pending re-enables a still-pending bed's button (allowing a duplicate) and overwrites the other bed's messages.",
    "water-now-refresh-failure-hides-save": "On /beds, when POST /api/waterings succeeds but the follow-up GET /api/beds refresh fails, the watering is reported as failed or the whole bed list is replaced by 'Could not load beds.', inviting a retry that records a duplicate.",
    "waterings-error-no-retry": "When GET /api/waterings fails, the /waterings page and the dashboard 'Recent waterings' section show only an error message with no Retry control, so recovery needs a full reload (or a filter change).",
    "waterings-malformed-json-uncaught": "Opening /waterings when GET /api/waterings returns malformed JSON throws an unhandled render error and shows the dev error overlay.",
    "waterings-beds-error-silent": "On /waterings, if GET /api/beds fails the error is ignored and the bed filter silently offers only 'All beds' with no message or retry.",
    "waterings-invalid-bed-query-raw-error": "Opening /waterings?bed=abc shows the raw validation text 'Query.bed id: Input should be a valid integer...' with a select that matches no option instead of ignoring or explaining the bad filter.",
    "waterings-filter-ignores-url-change": "On /waterings the bed filter is read from the URL only at setup, so navigating from /waterings?bed=1 to /waterings via the nav link or Back keeps showing the filtered list.",
    "waterings-stale-filter-results": "On /waterings, quickly changing the bed filter on a slow or failing network can leave a previous bed's rows shown under the new filter, alongside an error or overwritten by a late response.",
    "waterings-navigation-blocked-on-hang": "Clicking the Waterings nav link while GET /api/waterings hangs leaves the previous page on screen indefinitely with no loading feedback, because the page blocks on a top-level await.",
    "dashboard-waterings-no-loading-state": "The dashboard 'Recent waterings' section renders nothing but its heading while GET /api/waterings is pending on client-side navigation, because it has no loading branch.",
    "delete-missing-watering-error": "On /waterings, deleting a watering that was already deleted (second tab or retry) shows the 404 'Watering not found.' as an error and leaves the stale row until a reload.",
    "long-bed-name-table-overflow": "A bed with a long unbroken name (up to 60 characters) makes the watering tables on /waterings and the dashboard overflow horizontally at a 375 px viewport.",
    "huge-litres-layout-overflow": "A stored extreme litres value such as -1e308 renders as a several-hundred-digit unwrapped number on /waterings and the dashboard, forcing horizontal scrolling at 375 px.",
    "beds-malformed-json-add-bed-stuck": "On /beds, when GET /api/beds returns malformed JSON an unhandled render error occurs and the 'Add bed' button stays disabled on 'Adding…'.",
    "beds-500-typed-values-lost": "On /beds, when GET /api/beds fails with 500 after adding a bed, the typed Name value is cleared and there is no retry path without a reload."
  }
}
