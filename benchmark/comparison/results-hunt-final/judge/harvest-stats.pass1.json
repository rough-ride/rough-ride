  "issues": {
    "error-shown-as-empty": "On /stats, when GET /api/stats/harvests fails (for example a 500, or a 422 for a From date after the To date), the page shows the empty state 'No harvests in this range' instead of an error.",
    "to-date-excluded": "On /stats and GET /api/stats/harvests, a harvest logged on the To date is left out of the table, totals and best plants, as seen with a single-day range where From equals To.",
    "stats-malformed-response-crash-stuck-loading": "On /stats, when GET /api/stats/harvests returns a malformed or empty-object body, an uncaught TypeError (reading 'length') is thrown, no error is shown, and 'Loading stats…' stays on screen over the previous range's table and best plants.",
    "stats-hang-loading-forever-stale-data": "On /stats, when the stats request never answers after changing the date range, 'Loading stats…' stays indefinitely above the previous range's results with no timeout, error or retry.",
    "stats-cleared-to-extends-to-year-end": "On /stats, clearing the To field while From is set silently queries up to 31 Dec of the current year while the To field stays blank."
  }
