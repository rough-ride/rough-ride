  "issues": {
    "error-shown-as-empty": "On /stats, when GET /api/stats/harvests fails (for example a 500, or a 422 from a From date after the To date), the page shows the empty state 'No harvests in this range' instead of an error or the server's reason.",
    "to-date-excluded": "On /stats and GET /api/stats/harvests, a harvest logged on the To date is excluded from the table, totals and best plants because the query uses harvested_on < to, so for example From = To = the harvest day shows 0 harvests.",
    "stats-cleared-to-extends-to-year-end": "On /stats, clearing the To field leaves it blank while the stats silently use the end of the current year as the range end, for example From 2025-01-01 shows '6 harvests from 1 Jan 2025 to 31 Dec 2026'.",
    "stats-malformed-response-crash-stuck-loading": "On /stats, when GET /api/stats/harvests returns a malformed or empty-object body, rendering throws an uncaught TypeError reading stats.plants.length, no error is shown, and the page stays on 'Loading stats…' over the previous range's table and best plants (or navigation to Stats fails and leaves the user on the Dashboard).",
    "stats-hang-loading-forever-stale-data": "On /stats, when the stats request never answers after changing the date range, 'Loading stats…' stays indefinitely above the previous range's table and best plants with no timeout, error or retry."
  }
}
