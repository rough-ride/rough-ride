{
  "name": "rough-ride",
  "version": "0.1.4",
  "description": "Attacks a web app that a coding agent just changed with faults and bad inputs, and judges whether it stays usable and honest.",
  "author": {
    "name": "rough-ride maintainers"
  },
  "license": "MIT",
  "repository": "https://github.com/rough-ride/rough-ride",
  "mcpServers": {
    "rough-ride-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.12.0",
        "--autoConnect",
        "--userDataDir=${CLAUDE_PLUGIN_DATA}/repro-profile",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1",
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      }
    }
  }
}
