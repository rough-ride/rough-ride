{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/rough-patch/rough-patch/v0.1.0/packages/rough-patch/src/schemas/accepted.schema.json",
  "title": "rough-patch accepted.yaml",
  "description": "Findings a person accepted, keyed by page, step, action and check. People write this file; the runner never does.",
  "type": "object",
  "required": [
    "schema",
    "accepted"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "description": "The format version: the rough-patch release that introduced it.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "accepted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "page",
          "step",
          "action",
          "check",
          "because"
        ],
        "additionalProperties": false,
        "properties": {
          "page": {
            "type": "string",
            "pattern": "^/"
          },
          "step": {
            "enum": [
              "goto",
              "click",
              "fill",
              "select",
              "check",
              "press",
              "expect"
            ]
          },
          "action": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "because": {
            "type": "string",
            "pattern": "^[^\\r\\n]{1,200}$"
          }
        }
      }
    }
  }
}
