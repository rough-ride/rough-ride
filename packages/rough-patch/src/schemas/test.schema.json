{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/rough-patch/rough-patch/v0.1.0/packages/rough-patch/src/schemas/test.schema.json",
  "title": "rough-patch regression test",
  "description": "A regression test in .rough-patch/tests/<name>.yaml: one attack on one flow and the checks it failed.",
  "type": "object",
  "required": [
    "schema",
    "flow",
    "attack",
    "checks",
    "context",
    "found"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "description": "The format version: the rough-patch release that introduced it.",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "flow": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "attack": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "fault",
            "sticky",
            "request",
            "page"
          ],
          "additionalProperties": false,
          "properties": {
            "fault": {
              "enum": [
                "500",
                "400",
                "401",
                "429",
                "malformed-json",
                "empty-200",
                "reset",
                "hang",
                "delay-3s"
              ]
            },
            "sticky": {
              "type": "boolean"
            },
            "request": {
              "type": "string",
              "pattern": "^[A-Z]+ /.* #[0-9]+$"
            },
            "page": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "badInput",
            "page",
            "field"
          ],
          "additionalProperties": false,
          "properties": {
            "badInput": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
            },
            "page": {
              "type": "string",
              "pattern": "^/"
            },
            "request": {
              "type": "string",
              "pattern": "^[A-Z]+ /"
            },
            "field": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "name",
                    "kind"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "timing",
            "request",
            "page"
          ],
          "additionalProperties": false,
          "properties": {
            "timing": {
              "const": "double-submit"
            },
            "request": {
              "type": "string",
              "pattern": "^[A-Z]+ /.* #[0-9]+$"
            },
            "page": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "timing",
            "page",
            "request",
            "field"
          ],
          "additionalProperties": false,
          "properties": {
            "timing": {
              "const": "out-of-order"
            },
            "page": {
              "type": "string",
              "pattern": "^/"
            },
            "request": {
              "type": "string",
              "pattern": "^[A-Z]+ /"
            },
            "field": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "timing",
            "page",
            "entry"
          ],
          "additionalProperties": false,
          "properties": {
            "timing": {
              "enum": [
                "refresh",
                "back",
                "signed-out-reload"
              ]
            },
            "page": {
              "type": "string",
              "pattern": "^/"
            },
            "entry": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "viewport"
          ],
          "additionalProperties": false,
          "properties": {
            "viewport": {
              "const": 375
            }
          }
        }
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "enum": [
              "one-write",
              "no-5xx-on-bad-input",
              "visible-error-message",
              "settles",
              "latest-response-wins",
              "values-survive",
              "retry-recovers",
              "no-broken-text",
              "no-uncaught-error",
              "no-overflow-375"
            ]
          },
          {
            "type": "object",
            "required": [
              "id",
              "at",
              "assert",
              "spec",
              "because"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^app-[a-z0-9][a-z0-9-]{0,39}$"
              },
              "at": {
                "enum": [
                  "settled",
                  "end",
                  "every-step"
                ]
              },
              "when": {
                "type": "object",
                "required": [],
                "additionalProperties": false,
                "properties": {
                  "outcome": {
                    "enum": [
                      "told",
                      "refused",
                      "accepted"
                    ]
                  }
                }
              },
              "assert": {
                "description": "Exactly one condition: text, count, path, requests or outcome.",
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "text": {
                        "type": "string"
                      },
                      "within": {
                        "description": "Exactly one of role (with an optional name), label, text or testId.",
                        "oneOf": [
                          {
                            "type": "object",
                            "required": [
                              "role"
                            ],
                            "additionalProperties": false,
                            "properties": {
                              "role": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              }
                            }
                          },
                          {
                            "type": "object",
                            "required": [
                              "label"
                            ],
                            "additionalProperties": false,
                            "properties": {
                              "label": {
                                "type": "string"
                              }
                            }
                          },
                          {
                            "type": "object",
                            "required": [
                              "text"
                            ],
                            "additionalProperties": false,
                            "properties": {
                              "text": {
                                "type": "string"
                              }
                            }
                          },
                          {
                            "type": "object",
                            "required": [
                              "testId"
                            ],
                            "additionalProperties": false,
                            "properties": {
                              "testId": {
                                "type": "string"
                              }
                            }
                          }
                        ]
                      },
                      "absent": {
                        "const": true
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "count"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "count": {
                        "type": "object",
                        "required": [
                          "of"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "of": {
                            "description": "Exactly one of role (with an optional name), label, text or testId.",
                            "oneOf": [
                              {
                                "type": "object",
                                "required": [
                                  "role"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                  "role": {
                                    "type": "string"
                                  },
                                  "name": {
                                    "type": "string"
                                  }
                                }
                              },
                              {
                                "type": "object",
                                "required": [
                                  "label"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                  "label": {
                                    "type": "string"
                                  }
                                }
                              },
                              {
                                "type": "object",
                                "required": [
                                  "text"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                  "text": {
                                    "type": "string"
                                  }
                                }
                              },
                              {
                                "type": "object",
                                "required": [
                                  "testId"
                                ],
                                "additionalProperties": false,
                                "properties": {
                                  "testId": {
                                    "type": "string"
                                  }
                                }
                              }
                            ]
                          },
                          "is": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "atLeast": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "atMost": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "path"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "object",
                        "required": [],
                        "additionalProperties": false,
                        "properties": {
                          "is": {
                            "type": "string",
                            "pattern": "^/"
                          },
                          "isNot": {
                            "type": "string",
                            "pattern": "^/"
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "requests"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "requests": {
                        "type": "object",
                        "required": [
                          "key"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "key": {
                            "type": "string",
                            "pattern": "^[A-Z]+ /"
                          },
                          "status": {
                            "enum": [
                              "2xx",
                              "3xx",
                              "4xx",
                              "5xx",
                              "failed"
                            ]
                          },
                          "is": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "atLeast": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "atMost": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "outcome"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "outcome": {
                        "enum": [
                          "accepted",
                          "refused"
                        ]
                      }
                    }
                  }
                ]
              },
              "spec": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
              },
              "because": {
                "type": "string",
                "pattern": "^[ -~]{1,160}$"
              }
            }
          }
        ]
      }
    },
    "context": {
      "type": "object",
      "required": [
        "timezone",
        "locale"
      ],
      "additionalProperties": false,
      "properties": {
        "timezone": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        }
      }
    },
    "found": {
      "type": "object",
      "required": [
        "finding",
        "run",
        "runner",
        "date"
      ],
      "additionalProperties": false,
      "properties": {
        "finding": {
          "type": "string"
        },
        "run": {
          "type": "string",
          "pattern": "^[0-9]{8}-[0-9]{6}-[a-z]+-[a-z0-9]{4}$"
        },
        "runner": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "held": {
          "type": "object",
          "required": [
            "length",
            "preview",
            "cutBy"
          ],
          "additionalProperties": false,
          "properties": {
            "length": {
              "type": "integer",
              "minimum": 0
            },
            "preview": {
              "type": "string"
            },
            "cutBy": {
              "oneOf": [
                {
                  "const": "maxlength"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "bodyKind": {
          "type": "string"
        }
      }
    }
  }
}
